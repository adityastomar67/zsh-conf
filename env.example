# ------------------------[  ENVIRONMENT VARIABLES TEMPLATE  ]------------------------ #
# This file contains sensitive keys and secrets.
#
# INSTRUCTIONS:
# 1. Copy this file: cp env.example ~/.config/zsh-conf/env.zsh
# 2. Edit the file:  vim ~/.config/zsh-conf/env.zsh
# 3. Secure the file: chmod 600 ~/.config/zsh-conf/env.zsh
#
# NOTE: The 'env.zsh' file is automatically sourced by zshrc if it exists.


# ........................[  AI & LLM Services  ]........................ #

# OpenAI API Key (Chat, Codex, etc.)
# export OPENAI_API_KEY="sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Anthropic API Key (Claude)
# export ANTHROPIC_API_KEY="sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX"

# Gemini / Google AI
# export GEMINI_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXX"


# ........................[  Development Tools  ]........................ #

# GitHub Token (For enhanced git operations/CLI)
# export GITHUB_TOKEN="ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Homebrew GitHub API Token (Avoid rate limits)
# export HOMEBREW_GITHUB_API_TOKEN="ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# FZF Default Options (Override system defaults if needed)
# export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"


# ........................[  Custom Secrets  ]........................ #

# Any other private variables
# export MY_SECRET_VAR="some-secret-value"
