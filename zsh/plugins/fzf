#!/usr/bin/env zsh

if ! is_installed fzf; then
    printf "\n\033[0;33m[WARN] USE_FUNCTION='Yes' but 'fzf' is not installed.\033[0m\n"
    return
fi

local CLIP_CMD=""

if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    CLIP_CMD="pbcopy"
elif [[ -n "$WAYLAND_DISPLAY" ]] && (( $+commands[wl-copy] )); then
    # Linux (Wayland)
    CLIP_CMD="wl-copy"
elif (( $+commands[xclip] )); then
    # Linux (X11) - xclip
    CLIP_CMD="xclip -selection clipboard"
elif (( $+commands[xsel] )); then
    # Linux (X11) - xsel
    CLIP_CMD="xsel --clipboard --input"
else
    # Fallback (Just prints to terminal if no clipboard found)
    CLIP_CMD="cat"
fi

_fzf_compgen_dir() {
    local base_dir="$1"

    # 1. Use 'fd' (Best performance)
    if is_installed fd; then
        fd --type d --hidden --follow --color=always \
           --exclude ".git" \
           --exclude "node_modules" \
           . "$base_dir"

    # 2. Fallback to 'find' (Universal)
    else
        # Logic:
        # IF name is .git OR node_modules -> Prune (Skip entire folder)
        # ELSE IF it is a directory -> Print it
        command find -L "$base_dir" \
            \( -name .git -o -name node_modules \) -prune -o \
            -type d -print 2>/dev/null
    fi
}

_fzf_compgen_unalias() {
    # 1. Create a secure temp file (works on Linux & macOS)
    local tmp=$(mktemp "${TMPDIR:-/tmp}/zsh-aliases.XXXXXX")

    # 2. Auto-Cleanup: Remove file when this function finishes (Success or Failure)
    trap "rm -f '$tmp'" EXIT

    # 3. Dump current aliases to the file
    # We need a file because the FZF preview window runs in a separate subshell
    # and doesn't know about the aliases defined in your current session.
    alias > "$tmp"

    # 4. Construct the Preview Command
    # - grep -F: Search for fixed strings (no regex escaping needed)
    # - {}=    : Matches 'aliasname=' to ensure exact match
    local preview_cmd="grep -F --color=always \"{}=\" '$tmp'"

    # Optional: Use bat for syntax highlighting if available
    if is_installed bat; then
        # -l zsh : Force Zsh syntax highlighting
        # --plain: Remove grid/headers for cleaner look in small window
        preview_cmd="$preview_cmd | bat -l zsh --style=plain --color=always"
    fi

    # 5. Run FZF
    # Input: "${(@k)aliases}" gets just the names (keys) of all aliases
    print -l "${(@k)aliases}" | fzf "$@" --preview "$preview_cmd"
}

_fzf_comprun() {
    local command=$1
    shift

    case "$command" in
        # 1. Directory Navigation
        cd|pushd|rmdir)
            if is_installed eza; then
                fzf "$@" --preview 'eza --tree --level=2 --color=always --icons=always --group-directories-first {} | head -200'
            elif is_installed tree; then
                fzf "$@" --preview 'tree -C {} | head -200'
            else
                # Fallback for stock Mac/Linux
                fzf "$@" --preview 'ls -1 --color=always {} | head -200'
            fi
            ;;

        # 2. Editors & Viewers
        vim|nvim|vi|nano|code|cat|bat|less|more)
            if is_installed bat; then
                fzf "$@" --preview 'bat --style=numbers --color=always --line-range :500 {}' \
                        --preview-window 'right:60%:border-left'
            else
                fzf "$@" --preview 'cat {}'
            fi
            ;;

        # 3. Environment Variables
        export|unset|printenv)
            fzf "$@" --preview "printenv {}" --preview-window="bottom:3:wrap"
            ;;

        # 4. SSH & Telnet
        ssh|telnet)
            fzf "$@" --preview 'cat ~/.ssh/config 2>/dev/null | grep -A 4 "Host {}" || echo "System Host: {}"' \
                    --preview-window="bottom:20%:wrap"
            ;;

        # 5. Process Management
        kill|pkill)
            fzf "$@" --preview 'ps -fp {1} 2>/dev/null || echo "Process not found"' \
                    --preview-window="bottom:20%:wrap"
            ;;

        # 6. Service Management (Linux)
        systemctl)
             fzf "$@" --preview 'systemctl status {1} --no-pager 2>/dev/null || echo "Status unavailable"' \
                      --preview-window="right:60%:wrap"
             ;;

        # 7. Service Management (macOS)
        #    'launchctl list' shows PID, Last Exit Status, and Label
        launchctl)
             fzf "$@" --preview 'launchctl list {1} 2>/dev/null || echo "No info available for {1}"' \
                      --preview-window="bottom:20%:wrap"
             ;;

        # 8. Git
        git)
            if is_installed delta; then
                fzf "$@" --preview 'git diff --color=always {} | delta' --preview-window 'right:60%'
            else
                fzf "$@" --preview 'git diff --color=always {}' --preview-window 'right:60%'
            fi
            ;;

        # 9. Unalias
        unalias)
            _fzf_compgen_unalias "$@"
            ;;

        # 10. Fallback (Everything else)
        *)
            # We determine the preview command HERE in the parent shell
            # because 'is_installed' cannot be called inside the 'fzf' subshell.

            local preview_cmd="echo {}"

            # Determine File Viewer
            if is_installed bat; then
                # If it's a file, use bat
                preview_cmd="if [ -f {} ]; then bat --style=numbers --color=always --line-range :500 {};"
            else
                preview_cmd="if [ -f {} ]; then cat {};"
            fi

            # Determine Directory Viewer
            if is_installed eza; then
                 # Append eza logic
                 preview_cmd+=" elif [ -d {} ]; then eza --tree --level=2 --color=always --icons=always {} | head -200;"
            elif is_installed tree; then
                 preview_cmd+=" elif [ -d {} ]; then tree -C {} | head -200;"
            else
                 preview_cmd+=" elif [ -d {} ]; then ls -1 --color=always {};"
            fi

            # Close the logic
            preview_cmd+=" else echo {}; fi"

            # Run FZF with the constructed command
            fzf "$@" --preview "$preview_cmd"
            ;;
    esac
}
    # --color=fg+:#ffffff,bg+:#1f2335,hl+:#7dcfff
# --- Base Colors ---
local c_fg="#c0caf5"          # Main Text
local c_bg="-1"               # Main Background (-1 = Transparent)
local c_hl="#bb9af7"          # Highlighted Matches (Purple)

# --- Selection Colors (The current line) ---
local c_fg_sel="#ffffff"      # Selected Text (Bright White)
local c_bg_sel="#1f2335"      # Selected Background (Dark Blue)
local c_hl_sel="#7dcfff"      # Selected Match (Cyan)

# --- UI Elements ---
local c_prompt="#f7768e"      # Prompt & Pointer (Red/Pink)
local c_spinner="#9ece6a"     # Spinner & Markers (Green)
local c_info="#7aa2f7"        # Info counters (Blue)
local c_header="#9ece6a"      # Header text (Green)
local c_query="#ddb6f2"       # Typed Query (Lavender)

# --- Borders ---
local c_border="#414868"      # Main Border (Muted Blue)
local c_preview="#aeaeae"     # Preview Border (Grey)
local c_label="#aeaeae"       # Border Label (Grey)
local c_gutter="-1"           # Gutter column (-1 = Transparent)

# ==============================================================================
# 2. FZF CONFIGURATION
# ==============================================================================

export FZF_DEFAULT_OPTS="
    # --- Apply Colors from Variables ---
    --color=fg:${c_fg},bg:${c_bg},hl:${c_hl}
    --color=fg+:${c_fg_sel},bg+:${c_bg_sel},hl+:${c_hl_sel}
    --color=info:${c_info},prompt:${c_prompt},pointer:${c_prompt}
    --color=marker:${c_spinner},spinner:${c_spinner},header:${c_header}
    --color=border:${c_border},label:${c_label},query:${c_query}
    --color=preview-border:${c_prompt}

    # 2. UI SETTINGS
    --border='rounded'
    --border-label='  Search '
    --border-label-pos='4'
    --preview-window='border-rounded,hidden'
    --prompt='  '
    --pointer='▌'
    --marker=' '
    --info='inline'
    --height='45%'
    --layout='reverse'
    --margin='1'
    --padding='1'
    --preview '[[ \$(file --mime {}) =~ binary ]] && echo {} is a binary file || (bat --style=numbers --color=always {} || cat {}) 2> /dev/null | head -500'

    # 3. KEYBINDINGS
    --bind 'ctrl-j:preview-down'
    --bind 'ctrl-k:preview-up'
    --bind 'ctrl-a:select-all'
    --bind 'ctrl-y:execute-silent(echo {+} | $CLIP_CMD)'
    --bind 'ctrl-e:execute(echo {+} | xargs -o nvim)'
    --bind 'ctrl-v:execute(code {+})'
    --bind 'tab:down,shift-tab:up'
    --bind 'ctrl-/:toggle-preview'
"

# ........................[  FZF Configuration  ]........................ #

# 1. Determine the best search tool available
#    Priority: ripgrep (rg) > fd > find

local _fzf_ignore_list=(
    .git
    .mypy_cache
    .tox
    .cache
    .venv
    venv
    node_modules
    __pycache__
    site-packages
)

if is_installed rg; then
    # RG: Fastest, respects .gitignore automatically
    # 1. Define your ignored folders in a clean list
#    (No need for wildcards like '/*' - rg matches directory names automatically)

# 2. Build the command dynamically
#    This magic Zsh syntax prepends "--glob '!.name'" to every item
export FZF_DEFAULT_COMMAND="rg --files --hidden --follow ${(@)_fzf_ignore_list/#/--glob \!}"
    # Note: rg isn't great for finding *only* directories, so we fallback to find or simple listing
    export FZF_ALT_C_COMMAND='find . -type d'
elif is_installed fd; then

    local fd_excludes="${(@)_fzf_ignore_list/#/--exclude }"
        # FD: Specialized for file finding, colorful, respects .gitignore
        #    We inject the generated string directly into the command
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --strip-cwd-prefix $fd_excludes"
    export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --strip-cwd-prefix $fd_excludes"

else
    # FIND: Universal fallback (slower)
    export FZF_DEFAULT_COMMAND='find . -type f'
    export FZF_ALT_C_COMMAND='find . -type d'

fi

# 2. Apply to Ctrl-T (File Finder)


# ........................[  FZF Preview Strategy  ]........................ #

# 1. Select File Previewer (Run once at startup)
# ------------------------------------------------------------------------------
# We prioritize 'bat' (syntax highlighting), fallback to 'cat' (standard).
local _fzf_preview_file_cmd
if is_installed bat; then
    _fzf_preview_file_cmd='bat --color=always --style=numbers --line-range=:500 {}'
else
    _fzf_preview_file_cmd='cat {}'
fi

# 2. Select Directory Previewer
# ------------------------------------------------------------------------------
# We prioritize 'eza' (modern ls), fallback to 'tree', then 'ls'.
local _fzf_preview_dir_cmd
if is_installed eza; then
    _fzf_preview_dir_cmd='eza --tree --color=always {} | head -200'
elif is_installed tree; then
    _fzf_preview_dir_cmd='tree -C {} | head -200'
else
    _fzf_preview_dir_cmd='ls -1 {}'
fi

# 3. Apply Exports
# ------------------------------------------------------------------------------

# Ctrl-T: File Finder
# We inject the pre-selected ${_fzf_preview_file_cmd} directly.
export FZF_CTRL_T_OPTS="
  --preview '$_fzf_preview_file_cmd 2>/dev/null'
  --bind 'ctrl-/:toggle-preview'
"

# Alt-C: Directory Changer
# We inject the pre-selected ${_fzf_preview_dir_cmd} directly.
export FZF_ALT_C_OPTS="
  --preview '$_fzf_preview_dir_cmd 2>/dev/null'
"

# Clean up local variables to keep memory clean
unset _fzf_preview_file_cmd _fzf_preview_dir_cmd


#    We reuse the same command so Ctrl-T is just as fast.
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"



# Load fzf keybindings and completion for macOS (Homebrew)
[[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]] && source /opt/homebrew/opt/fzf/shell/completion.zsh
[[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

