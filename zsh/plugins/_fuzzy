# ------------------------------------------------------------------------------
# File Purpose
#   Configures FZF (Fuzzy Finder) as the primary interaction layer for Zsh.
#   It overrides standard completions and keybindings to provide rich,
#   context-aware previews for files, directories, processes, and more.
#
# Problems Solved
#   - Standard Tab-completion is static; FZF makes it searchable and visual.
#   - Replaces slow 'find' calls with optimized tools like 'rg' or 'fd'.
#   - Provides "instant-read" previews (syntax-highlighted code, directory trees).
#   - Standardizes clipboard and editor integration across platforms.
#
# Features / Responsibilities
#   - **Smart Compgen:** Optimized directory/file discovery logic.
#   - **Contextual Previews:** Dynamic logic for `cd`, `vim`, `ssh`, `git`, etc.
#   - **Unified UI:** Rounded borders, consistent color palette, and iconography.
#   - **High-Speed Search:** Native integration with Ripgrep and FD.
#
# Usage Notes
#   - Requires: `fzf` (Binary).
#   - Optional: `bat`, `eza`, `fd`, `rg`, `delta` for enhanced visuals.
# ------------------------------------------------------------------------------


# ── custom completion engines ────────────────────────────────────────────────

# ------------------------------------------------------------------------------
# Function: _fzf_compgen_dir
# Description: Overrides directory discovery for FZF completions.
# ------------------------------------------------------------------------------
_fzf_compgen_dir() {
    local base_dir="$1"

    if (( $+commands[fd] )); then
        # Use 'fd' for performance and automatic .gitignore respect
        fd --type d --hidden --follow --color=always \
           --exclude ".git" \
           --exclude "node_modules" \
           . "$base_dir"
    else
        # Fallback to universal 'find' with pruning logic for heavy folders
        command find -L "$base_dir" \
            \( -name .git -o -name node_modules \) -prune -o \
            -type d -print 2>/dev/null
    fi
}

# ------------------------------------------------------------------------------
# Function: _fzf_compgen_unalias
# Description: Specialized FZF picker for unsetting shell aliases with previews.
# ------------------------------------------------------------------------------
_fzf_compgen_unalias() {
    local tmp=$(mktemp "${TMPDIR:-/tmp}/zsh-aliases.XXXXXX")
    trap "rm -f '$tmp'" EXIT

    # Capture current aliases to a temp file for the FZF subshell to read
    alias > "$tmp"

    local preview_cmd="grep -F --color=always \"{}=\" '$tmp'"
    if (( $+commands[bat] )); then
        preview_cmd="$preview_cmd | bat -l zsh --style=plain --color=always"
    fi

    print -l "${(@k)aliases}" | fzf "$@" --preview "$preview_cmd"
}

# ------------------------------------------------------------------------------
# Function: _fzf_comprun
# Description: The "Brain" of FZF context-awareness. It determines what preview
#              to show based on the command you are currently typing.
# ------------------------------------------------------------------------------
_fzf_comprun() {
    local command=$1
    shift

    case "$command" in
        # 1. Navigation (cd/pushd) -> Show Directory Trees
        cd|pushd|rmdir)
            if (( $+commands[eza] )); then
                fzf "$@" --preview 'eza --tree --level=2 --color=always --icons=always --group-directories-first {} | head -200'
            elif (( $+commands[tree] )); then
                fzf "$@" --preview 'tree -C {} | head -200'
            else
                fzf "$@" --preview 'ls -1 --color=always {} | head -200'
            fi
            ;;

        # 2. Files (vim/cat/bat) -> Show Syntax Highlighted Code
        vim|nvim|vi|nano|code|cat|bat|less|more)
            if (( $+commands[bat] )); then
                fzf "$@" --preview 'bat --style=numbers --color=always --line-range :500 {}' \
                        --preview-window 'right:60%:border-left'
            else
                fzf "$@" --preview 'cat {}'
            fi
            ;;

        # 3. Environment & Processes -> Show Values/Status
        export|unset|printenv)
            fzf "$@" --preview "printenv {}" --preview-window="bottom:3:wrap"
            ;;
        kill|pkill)
            fzf "$@" --preview 'ps -fp {1} 2>/dev/null || print "Process not found"' \
                    --preview-window="bottom:20%:wrap"
            ;;

        # 4. Networking & SSH -> Show Config Fragments
        ssh|telnet)
            fzf "$@" --preview 'cat ~/.ssh/config 2>/dev/null | grep -A 4 "Host {}" || print "System Host: {}"' \
                    --preview-window="bottom:20%:wrap"
            ;;

        # 5. Git -> Show Colorful Diffs
        git)
            if (( $+commands[delta] )); then
                fzf "$@" --preview 'git diff --color=always {} | delta' --preview-window 'right:60%'
            else
                fzf "$@" --preview 'git diff --color=always {}' --preview-window 'right:60%'
            fi
            ;;

        unalias) _fzf_compgen_unalias "$@" ;;

        systemctl)
             fzf "$@" --preview 'systemctl status {1} --no-pager 2>/dev/null || print "Status unavailable"' \
                      --preview-window="right:60%:wrap"
             ;;

        # 7. Service Management (macOS)
        #    'launchctl list' shows PID, Last Exit Status, and Label
        launchctl)
             fzf "$@" --preview 'launchctl list {1} 2>/dev/null || print "No info available for {1}"' \
                      --preview-window="bottom:20%:wrap"
             ;;

        # 10. Multi-Tool Fallback logic for everything else
        *)
            local preview_cmd="print {}"
            if (( $+commands[bat] )); then
                preview_cmd="if [ -f {} ]; then bat --style=numbers --color=always --line-range :500 {};"
            else
                preview_cmd="if [ -f {} ]; then cat {};"
            fi

            if (( $+commands[eza] )); then
                 preview_cmd+=" elif [ -d {} ]; then eza --tree --level=2 --color=always --icons=always {} | head -200;"
            else
                 preview_cmd+=" elif [ -d {} ]; then ls -1 --color=always {};"
            fi
            preview_cmd+=" else print {}; fi"

            fzf "$@" --preview "$preview_cmd"
            ;;
    esac
}


# ── global fzf options & keybindings ──────────────────────────────────────────

export FZF_DEFAULT_OPTS="
    # -- -- -- TOKYO NIGHT COLOR PALETTE -- -- --
    --color=fg:#c0caf5,bg:-1,hl:#36608a:bold
    --color=fg+:#ffffff,bg+:#1f2335,hl+:#76b9e0:bold
    --color=info:#7aa2f7
    --color=prompt:#f7768e
    --color=pointer:#f7768e
    --color=marker:#9ece6a
    --color=spinner:#9ece6a
    --color=header:#9ece6a
    --color=label:#aeaeae
    --color=query:#ddb6f2
    --color=border:#414868
    --color=preview-border:#f7768e
    --gutter ' '
    --color gutter:-1

    # -- -- -- UI SETTINGS -- -- --
    --multi
    --border='rounded'
    --border-label='   Fuzzy Finder '
    --border-label-pos='4'
    --preview-window='border-rounded,hidden'
    --prompt='  '
    --pointer='▌'
    --marker=' '
    --info='inline'
    --height='65%'
    --layout='reverse'
    --margin='1'
    --padding='1,1,0,1'
    --preview '[[ \$(file --mime {}) =~ binary ]] && print {} is a binary file || (bat --style=numbers --color=always {} || cat {}) 2> /dev/null | head -500'

    # -- -- -- KEYBINDINGS -- -- --
    --bind 'ctrl-j:preview-down'
    --bind 'ctrl-k:preview-up'
    --bind 'ctrl-a:select-all'
    --bind 'ctrl-y:execute-silent(print {+} | $_clip)'
    --bind 'ctrl-e:execute(print {+} | xargs -o nvim)'
    --bind 'ctrl-v:execute(code {+})'
    --bind 'tab:down,shift-tab:up'
    --bind 'space:toggle'
    --bind 'ctrl-\:toggle-preview'
"


# ── search tool backend ──────────────────────────────────────────────────────

# Centralized list of noisy directories to ignore globally
local _fzf_ignore_list=(
    # ── Version Control ──
    .git .svn .hg

    # ── Python ──
    __pycache__ .mypy_cache .pytest_cache .ruff_cache .tox .venv venv env site-packages

    # ── Node.js & Frontend ──
    node_modules bower_components .npm .yarn .next .nuxt

    # ── Rust, Go, Java, C++ (Build Artifacts) ──
    target build dist out vendor .gradle

    # ── OS Junk & Caches ──
    .cache .DS_Store .Trash .Trashes Thumbs.db tmp temp logs

    # ── IDE & Editor Data ──
    .idea .vscode .eclipse
)

# Safely map the prefixes to new arrays
local -a rg_excludes=( "${(@)_fzf_ignore_list/#/--glob=!}" )
local -a fd_excludes=( "${(@)_fzf_ignore_list/#/--exclude=}" )

# Assign the Default File Searcher (Ctrl-T & Default FZF)
if (( $+commands[rg] )); then
    export FZF_DEFAULT_COMMAND="rg --files --hidden --follow ${rg_excludes[*]}"
elif (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --strip-cwd-prefix ${fd_excludes[*]}"
else
    # Fallback for standard POSIX find
    local find_prune="\\( -name \"${(j:\" -o -name \")_fzf_ignore_list}\" \\) -prune -o"
    export FZF_DEFAULT_COMMAND="find . $find_prune -type f -print"
fi

export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Assign the Directory Searcher (Alt-C)
if (( $+commands[fd] )); then
    export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --strip-cwd-prefix ${fd_excludes[*]}"
else
    local find_prune="\\( -name \"${(j:\" -o -name \")_fzf_ignore_list}\" \\) -prune -o"
    export FZF_ALT_C_COMMAND="find . $find_prune -type d -print"
fi

# ── keybinding-specific preview strategies ───────────────────────────────────

# Select File Previewer (Prioritize bat)
local _fzf_preview_file_cmd
if (( $+commands[bat] )); then
    _fzf_preview_file_cmd='bat --color=always --style=numbers --line-range=:500 {}'
else
    _fzf_preview_file_cmd='cat {}'
fi

# Select Directory Previewer (Prioritize eza)
local _fzf_preview_dir_cmd
if (( $+commands[eza] )); then
    _fzf_preview_dir_cmd='eza --tree --color=always {} | head -200'
elif (( $+commands[tree] )); then
    _fzf_preview_dir_cmd='tree -C {} | head -200'
else
    _fzf_preview_dir_cmd='ls -1 {}'
fi

# Apply Previews to Widgets
export FZF_CTRL_T_OPTS="--preview '$_fzf_preview_file_cmd 2>/dev/null' --bind 'ctrl-/:toggle-preview'"
export FZF_ALT_C_OPTS="--preview '$_fzf_preview_dir_cmd 2>/dev/null'"

# Cleanup helper variables
unset _fzf_preview_file_cmd _fzf_preview_dir_cmd


# ── os-specific shell loading ────────────────────────────────────────────────

# Load standard FZF completion and key-bindings for macOS (Homebrew paths)
[[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ]]   && source /opt/homebrew/opt/fzf/shell/completion.zsh
[[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh


# ── Fzf-Tab Configuration ────────────────────────────────────────────────

## Configuration for the fzf-tab plugin (rich previews).
zstyle ':completion:*' menu no      # Disable default menu (we use fzf-tab's menu)

# zstyle ':completion:*' format ''    # Need to set it to none so that it behaves right

# Group Descriptions (Fzf's theme)
zstyle ':completion:*:*:*:*:descriptions' format '[%d]'

# ── Behavior ──
# Trigger fzf on path completion automatically
zstyle ':fzf-tab:*' continuous-trigger '/'

# Switch groups with < and >
zstyle ':fzf-tab:*' switch-group '<' '>'

# ── Styling ──

# Use LS_COLORS for fzf-tab
zstyle ':fzf-tab:*' list-colors ${(s.:.)LS_COLORS}

# ── Context-Aware Previews ──
# Use 'bat' for file previews if available, otherwise cat
zstyle ':fzf-tab:complete:*:*' fzf-preview \
    'if [[ -d $realpath ]]; then
        # If it is a directory, list it with eza
        eza -1 --color=always --icons=always --group-directories-first $realpath
     else
        # If it is a file, show content with bat
        if (( $+commands[bat] )); then
            bat --color=always --style=numbers --line-range=:500 $realpath
        else
            cat $realpath
        fi
     fi'

# 'cd': Use 'eza' with tree view (limit level 2) to see folder structure
zstyle ':fzf-tab:complete:cd:*' fzf-preview \
    'eza --tree --level=2 --color=always --icons=always --group-directories-first --git $realpath'

# 'systemctl': Preview service status
zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview \
    'SYSTEMD_COLORS=1 systemctl status $word'

# 'command': Preview man page or file content
zstyle ':fzf-tab:complete:(-command-):*' fzf-preview \
    '[[ -n $builtins[$word] ]] && man $word || bat --color=always --style=plain $realpath 2>/dev/null'

# kill: Show process details
zstyle ':fzf-tab:complete:kill:argument-rest' fzf-preview \
    'ps --pid=$group --format=cmd --no-headers -w -w'

zstyle ':fzf-tab:complete:kill:argument-rest' fzf-flags \
    '--preview-window=down:3:wrap'


# ── Global FZF-Tab Options ────────────────────────────────────────────────
# Inherits FZF_DEFAULT_OPTS
zstyle ':fzf-tab:*' fzf-flags \
    --multi \
    --bind 'space:toggle' \
    --style=full \
    --height=45% \
    --pointer '>' \
    --color 'pointer:green:bold' \
    --color 'bg+:-1:,fg+:green:bold,hl+:yellow:bold,hl:gray:bold' \
    --color 'info:blue:bold,marker:yellow:bold' \
    --input-label ' Search ' \
    --color 'input-border:blue,input-label:blue:bold' \
    --list-label ' Results ' \
    --color 'list-border:green,list-label:green:bold' \
    --preview-label ' Preview ' \
    --color 'preview-border:magenta,preview-label:magenta:bold' \
    --gutter ' ' \
    --color 'gutter:-1' \
    --bind 'ctrl-\:toggle-preview'

zstyle ':fzf-tab:*' fzf-bindings 'space:accept'
zstyle ':fzf-tab:*' accept-line enter
