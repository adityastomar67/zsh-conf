fzf-docker-ops() {
    # Guard: Is Docker running?
    if ! docker ps > /dev/null 2>&1; then
        zle -M "⚠️  Docker is not running."
        return
    fi

    local container_id action selected_line

    # 1. Select Container
    #    Format: ID | Name | Image | Status
    #    Preview: Live logs using 'bat' or plain 'tail'
    selected_line=$(docker ps -a --format "table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}" | \
        fzf --header-lines=1 \
            --prompt="🐳 Container > " \
            --height=80% \
            --preview "docker logs --tail 50 {1} 2>&1 | bat --color=always --style=numbers --language=log 2>/dev/null || docker logs --tail 50 {1}" \
            --preview-window="bottom:50%:wrap" \
            --pointer="➜"
    )

    # Extract ID (first column)
    container_id=$(echo "$selected_line" | awk '{print $1}')

    if [[ -n "$container_id" ]]; then
        # 2. Select Action
        #    Define a list of common actions
        local actions=(
            "📜 Logs (Follow)   : docker logs -f"
            "💻 Attach (Bash)   : docker exec -it /bin/bash"
            "🐚 Attach (Sh)     : docker exec -it /bin/sh"
            "▶️  Start           : docker start"
            "yw  Stop            : docker stop"
            "🔄 Restart         : docker restart"
            "🗑️  Remove          : docker rm"
            "🔍 Inspect         : docker inspect"
        )

        action=$(printf "%s\n" "${actions[@]}" | fzf \
            --prompt="⚡ Action for $container_id > " \
            --height=40% \
            --layout=reverse \
            | awk -F ':' '{print $2}' | xargs) # Extract command after colon

        # 3. Execute
        if [[ -n "$action" ]]; then
            # Special handling for Attach which requires inserting ID *before* the shell command
            if [[ "$action" == *"exec"* ]]; then
                # Split: "docker exec -it"  and  "/bin/bash"
                local base_cmd="${action% /*}"
                local shell_cmd="${action##* }"
                BUFFER="$base_cmd $container_id $shell_cmd"
            else
                # Standard commands: "docker start <ID>"
                BUFFER="$action $container_id"
            fi
            zle accept-line
        fi
    fi
    zle reset-prompt
}

# Bind to Alt+D (or Ctrl+G then D)
zle -N fzf-docker-ops
bindkey '^[d' fzf-docker-ops
