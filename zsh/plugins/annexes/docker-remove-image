function fzf_docker_rm_image() {
    # 1. Validation
    if ! command -v docker >/dev/null; then
        print "${COLOR[RED]}[ERROR]${COLOR[RESET]} Docker is not installed."
        return 1
    fi

    # 2. Local Override
    local FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS} --bind 'tab:toggle+down,shift-tab:toggle+up'"

    # 3. Get List
    #    We show ID, Repo, Tag, and Size
    local images
    images=$(docker images --format "table {{.ID}}\t{{.Repository}}\t{{.Tag}}\t{{.Size}}\t{{.CreatedSince}}" | \
        fzf --multi \
            --header-lines=1 \
            --prompt="💾 Rm Image > " \
            --height=60% \
            \
            # PREVIEW: Shows image history/layers
            --preview-window="right:65%:wrap:nohidden" \
            --preview 'docker history {1} | head -n 20 | bat --color=always --style=plain --language=dockerfile 2>/dev/null || docker inspect {1}'
    )

    # 4. Execution
    if [[ -n "$images" ]]; then
        # Extract just the Image IDs (Column 1)
        local -a ids
        ids=($(echo "$images" | awk '{print $1}'))

        print "\n${COLOR[YELLOW]}You are about to delete ${#ids[@]} image(s):${COLOR[RESET]}"
        print "${COLOR[RED]}${ids[*]}${COLOR[RESET]}"

        print -n "\n${COLOR[BOLD]}${COLOR[RED]}Are you sure? [y/N]${COLOR[RESET]}%b "
        if read -q choice; then
            echo
            # We use -f (force) to ensure it deletes even if untagged
            docker rmi -f "${ids[@]}"
            print "\n${COLOR[GREEN]}✔ Images deleted.${COLOR[RESET]}"
        else
            echo
            print "\n${COLOR[GREEN]}::${COLOR[RESET]} Cancelled."
        fi
    fi
}
