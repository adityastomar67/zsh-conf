
    local file
    local start_dir="${1:-.}"

    # 1. Generate List (Files only)
    local list_cmd
    if (( $+commands[fd] )); then
        list_cmd="fd --type f --hidden --follow --exclude .git . \"$start_dir\""
    else
        list_cmd="find \"$start_dir\" -type f -not -path '*/.git/*'"
    fi

    local FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS} --bind 'tab:toggle+down,shift-tab:toggle+up'"

    # 2. FZF Selection
    file=$(eval "$list_cmd" | fzf \
        --no-multi \
        --prompt="📄 Find File > " \
        --preview-window="right:60%:wrap:nohidden" \
        \
        # PREVIEW: Show file content
        --preview 'bat --style=numbers --color=always {} 2>/dev/null || cat {}' \
        \
        # BONUS: Ctrl-O to open file directly in EDITOR
        --bind "ctrl-o:execute($EDITOR {})+abort"
    )

    # 3. CD into Parent Directory
    if [[ -n "$file" ]]; then
        local dir=$(dirname "$file")
        print -P "\n%F{green}::%f Jumping to %B$dir%b..."
        cd "$dir" || return
    fi
