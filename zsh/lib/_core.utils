#!/usr/bin/env zsh
#    ░█▀▀░█▀█░█▀▄░█▀▀░░░░█░█░▀█▀░▀█▀░█░░░█▀▀
#    ░█░░░█░█░█▀▄░█▀▀░░░░█░█░░█░░░█░░█░░░▀▀█
#    ░▀▀▀░▀▀▀░▀░▀░▀▀▀░▀░░▀▀▀░░▀░░▀▀▀░▀▀▀░▀▀▀

# ------------------------------------------------------------------------------
# File Purpose
#   This script handles the initialization of the shell environment, specifically
#   managing the executable search path ($PATH) and providing global utility
#   functions used by other configuration modules.
#
# Problems Solved
#   - Prevents duplicate entries in $PATH (slows down command lookups).
#   - Automatically resolves relative paths (e.g., ".scripts" -> "/home/user/.scripts").
#   - Provides a cached "is_installed" check to optimize startup speed when
#     configuring aliases or plugins conditionally.
#
# Features / Responsibilities
#   - Unique Path Enforcement.
#   - Dynamic Path Expansion.
#   - Command Availability Caching.
#
# Usage Notes
#   - Relies on 'USER_PATH_ENTRIES' being defined in 'env.zsh'.
#
# Project: Zsh-conf
# ------------------------------------------------------------------------------
echo "Loading core utilities from _core.utils..."

# Load the completion initializer function
autoload -Uz compinit

# Load color definitions if not already present
autoload -Uz _ui.color && _ui.color

# Load the Defer utility for lazy loading
autoload -Uz Defer && Defer

# Plugin Manager Logic
# ─────────────────────────────────────────────────────────────
function plug() {

    # 1. Environment Preparation
    # Ensure the storage directory exists before trying to clone into it.
    if [[ ! -d "$ZPLUGIN_STORAGE_DIR" ]]; then
        mkdir -p "$ZPLUGIN_STORAGE_DIR"
    fi

    # 2. Input Resolution
    # If arguments are passed to the function, use them.
    # Otherwise, fall back to the global 'ZPLUGINS' array defined in config.
    local -a plugin_targets
    if (( $# > 0 )); then
        plugin_targets=("$@")
    else
        plugin_targets=("${ZPLUGINS[@]}")
    fi

    # 3. Processing Loop
    local repo_identifier plugin_name local_path entry_point
    local enable_deferral=0

    for repo_identifier in "${plugin_targets[@]}"; do

        # ── control flags ──────────────────────────────────────────────────────

        # Check if the current item is the 'defer' keyword.
        # This toggles lazy-loading for the *next* plugin in the list.
        if [[ "$repo_identifier" == "defer" ]]; then
            enable_deferral=1
            continue
        fi

        # ── installation logic ─────────────────────────────────────────────────

        # Extract the repo name (tail) from the identifier
        # Ex: "zsh-users/zsh-autosuggestions" -> "zsh-autosuggestions"
        plugin_name="${repo_identifier:t}"
        local_path="$ZPLUGIN_STORAGE_DIR/$plugin_name"

        # If the folder doesn't exist, clone it from GitHub
        if [[ ! -d "$local_path" ]]; then
            # Using 'print' is safer than echo in Zsh
            print ":: Installing plugin: $plugin_name..."

            # --depth 1: Shallow clone to save bandwidth and disk space
            git clone --depth 1 --quiet "https://github.com/${repo_identifier}.git" "$local_path"
        fi

        # ── entry point resolution ─────────────────────────────────────────────

        # We need to guess which file to source. We look for standard Zsh plugin
        # naming conventions in order of likelihood.
        # (N) = Nullglob: Returns empty string if no match found.

        local -a potential_entry_points=(
            # Exact matches for plugin name
            "$local_path/${plugin_name}.plugin.zsh"(N)
            "$local_path/${plugin_name}.zsh"(N)
            "$local_path/${plugin_name}.sh"(N)
            "$local_path/${plugin_name}.zsh-theme"(N)

            # Catch-all wildcards
            "$local_path"/*.plugin.zsh(N)
            "$local_path"/*.zsh(N)
        )

        # Select the first valid match
        entry_point="${potential_entry_points[2]}"

        # ── execution ──────────────────────────────────────────────────────────

        if [[ -f "$entry_point" ]]; then
            if (( enable_deferral )); then
                # Lazy Load: Schedule execution for when the shell is idle.
                # Requires the 'zsh-defer' utility loaded previously.
                echo "Deferred loading of plugin: $entry_point"
                Defer source "$entry_point"
            else
                # Eager Load: Execute immediately.
                echo "Loaded plugin: $plugin_name"
                source "$entry_point"
            fi
        fi

        # Reset flag for the next iteration
        enable_deferral=0
    done
}

# Ensure Cache Directory Exists
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/eval-cache"
[[ -d "$CACHE_DIR" ]] || mkdir -p "$CACHE_DIR"

_eval_cache() {
    local name="$1"
    local cmd="$2"
    local mode="${3:-defer}"

    local cache_file="$CACHE_DIR/${name}.zsh"
    local binary="$commands[$name]"

    # 1. Validation: If binary is missing, stop.
    if [[ -z "$binary" ]]; then
        return
    fi

    # 2. Invalidation Logic: Missing cache OR Binary is newer than cache
    if [[ ! -e "$cache_file" || "$binary" -nt "$cache_file" ]]; then
        # Atomic Write: Write to a temp file first, then move it.
        # This prevents reading a half-written file if you open multiple tabs.
        local tmp_file="${cache_file}.$$"

        # Run command, capture stdout. Only save if command succeeds.
        if eval "$cmd" > "$tmp_file"; then
            mv -f "$tmp_file" "$cache_file"
            # Background compilation so it doesn't block startup
            zcompile "$cache_file" &!
        else
            rm -f "$tmp_file"
            return 1 # Fail silently or log error
        fi
    fi

    # 3. Loading Logic
    if [[ "$mode" == "immediate" ]]; then
        source "$cache_file"
    elif (( $+functions[zsh-defer] )); then
        zsh-defer source "$cache_file"
    else
        # Fallback if zsh-defer is missing
        source "$cache_file"
    fi
}

# Path Construction
# ─────────────────────────────────────────────────────────────
## We construct the system $PATH and $FPATH (function path) here.
## Using specific Zsh flags ensures these arrays remain clean and efficient.

# 1. Global Uniqueness
# typeset -g : Global scope (vars persist after this script ends).
# typeset -U : Unique (automatically removes duplicates).
typeset -gU path fpath

# 2. Dynamic Path Injection
# Iterate through the array defined in env.zsh (USER_PATH_ENTRIES).
# Default to empty array if variable is unset.
for directory_entry in "${USER_PATH_ENTRIES[@]}"; do

    # Path Resolution Logic:
    # If the entry does NOT start with a slash (/), assume it is relative
    # to the user's home directory.
    if [[ "$directory_entry" != /* ]]; then
        directory_entry="$HOME/$directory_entry"
    fi

    # Existence Check:
    # Only add the directory to the $PATH if it actually exists on disk.
    # This prevents "command not found" errors and useless stat calls.
    if [[ -d "$directory_entry" ]]; then
        path+=("$directory_entry")
    fi
done

# Cleanup local loop variable
unset directory_entry


# Global Helpers & Caching
# ─────────────────────────────────────────────────────────────
## Utility functions required by the rest of the configuration.

# ------------------------------------------------------------------------------
# Caching Mechanism
# We use an associative array to store the result of 'command -v' checks.
# This prevents checking the filesystem multiple times for the same binary
# (e.g., checking if 'git' exists 50 times during startup).

typeset -gA COMMAND_AVAILABILITY_CACHE

# ------------------------------------------------------------------------------
# Function: is_installed
# Description:
#   Checks if a command exists in the $PATH. Returns 0 (true) or 1 (false).
#   Uses caching to speed up repeated checks.
#
# Usage:
#   if is_installed "nvim"; then ... fi

function is_installed() {
    local command_name="$1"

    # 1. Check Cache
    # If key exists in the hash map, return the stored exit code immediately.
    if [[ -n "${COMMAND_AVAILABILITY_CACHE[$command_name]}" ]]; then
        return "${COMMAND_AVAILABILITY_CACHE[$command_name]}"
    fi

    # 2. System Check
    # 'command -v' is the POSIX standard for checking executable existence.
    # &>/dev/null suppresses output (we only care about the exit code).
    command -v "$command_name" &>/dev/null
    local exit_code=$?

    # 3. Update Cache
    # Store the result (0 or 1) in the global map for next time.
    COMMAND_AVAILABILITY_CACHE[$command_name]=$exit_code

    # 4. Return Result
    return $exit_code
}

# ------------------------------------------------------------------------------
# Safe Edit Function
# Checks if the file exists before attempting to open it.
# ------------------------------------------------------------------------------
function _safe_edit() {
    local file="$1"
    local sudo_required="$2"

    # 1. Check if file exists
    if [[ ! -f "$file" ]]; then
        # Use colors if available (from your $C array), otherwise plain text
        echo "${COLOR[RED]:-Error:} File not found at ${COLOR[YELLOW]:-}$file${COLOR[RESET]:-}"
        return 1
    fi

    # 2. Open file
    if [[ "$sudo_required" == "true" ]]; then
        # Use standard 'visudo' for sudoers to ensure syntax checking
        if [[ "$file" == "/etc/sudoers" ]]; then
            echo "Using system 'visudo' for safety..."
            sudo visudo
        else
            sudo "$EDITOR" "$file"
        fi
    else
        "$EDITOR" "$file"
    fi
}

# Temporary Offline Config File
if [[ "${TEMP_OFFLINE_CONFIG:l}" == "yes" ]]; then

    # Store path in a local variable to ensure consistency
    local temp_file="$HOME/User-Overrides.zsh"

    # 1. Check if file exists; if not, create it with a header
    if [[ ! -f "$temp_file" ]]; then
        print "# Put temporary/offline aliases here. Not tracked by Git." > "$temp_file"
    fi
fi

# Guard: Only execute if 'RandomWall' is found in PATH or defined as a function
if [[ "${ENABLE_WALLPAPER_SYNC:l}" == "yes" ]] && is_installed RandomWall; then
    Defer RandomWall
fi
