#!/usr/bin/env zsh
#    ░█░█░▀█▀░░░░█▀▄░█▀▀░█▀█░█▀▀░█░█░█▄█░█▀█░█▀▄░█░█
#    ░█░█░░█░░░░░█▀▄░█▀▀░█░█░█░░░█▀█░█░█░█▀█░█▀▄░█▀▄
#    ░▀▀▀░▀▀▀░▀░░▀▀░░▀▀▀░▀░▀░▀▀▀░▀░▀░▀░▀░▀░▀░▀░▀░▀░▀

# ------------------------------------------------------------------------------
# File Purpose
#   This script generates the visual "Report Card" displayed after Zsh finishes
#   loading. It calculates a performance rating and renders a top-10 list
#   of the slowest functions using 'zprof'.
#
# Problems Solved
#   - Contextualizes raw milliseconds into human-readable ratings (e.g., "Fast").
#   - Visualizes bottlenecks with a bar chart.
#   - Filters verbose 'zprof' output into a clean summary table.
#
# Features / Responsibilities
#   - Performance Rating Logic (Blazing vs Sluggish).
#   - Boxed UI Rendering.
#   - AWK processing of profiling data.
#
# Usage Notes
#   - Requires 'zprof' to be enabled in the entry point.
#   - Expects '$total_duration_ms' to be calculated before sourcing.
#
# Project: Zsh-conf
# ------------------------------------------------------------------------------


# 0. Safety Checks & Dependencies
# ─────────────────────────────────────────────────────────────
## Ensure we have the necessary data and color definitions before rendering.

# Exit if the duration variable wasn't set by the parent script
[[ -z "$total_duration_ms" ]] && return


# 1. Performance Rating System
# ─────────────────────────────────────────────────────────────
## Categorizes the startup time into human-readable levels.

local performance_label="Unknown"
local label_color=${COLOR[WHITE]}

if (( total_duration_ms < 40 )); then
    performance_label="🚀 Blazing"
    label_color=${COLOR[GREEN]}

elif (( total_duration_ms < 100 )); then
    performance_label="⚡ Fast"
    label_color=${COLOR[CYAN]}

elif (( total_duration_ms < 200 )); then
    performance_label="🐢 Acceptable"
    label_color=${COLOR[YELLOW]} # Changed to Yellow for warning territory

else
    performance_label="🐌 Sluggish"
    label_color=${COLOR[RED]}
fi


# 2. Header Rendering
# ─────────────────────────────────────────────────────────────
## Draws the top box containing the total time and rating.

clear
# Top Border
printf "${COLOR[DIM]}╭───────────────────────────────────────────────────╮${COLOR[RESET]}\n"

# Content Row (Dynamic based on Minimal Mode)
if [[ "${ENABLE_MINIMAL_MODE:l}" == "yes" ]]; then
    printf "${COLOR[DIM]}│${COLOR[RESET]}  ZSH ${COLOR[YELLOW]}[MINIMAL]${COLOR[RESET]}    ${label_color}%-16s${COLOR[RESET]}    ${label_color}%6.2f ms${COLOR[RESET]}  ${COLOR[DIM]}│${COLOR[RESET]}\n" \
        "$performance_label" \
        "$total_duration_ms"
else
    printf "${COLOR[DIM]}│${COLOR[RESET]}  ZSH BENCHMARK        ${label_color}%-16s${COLOR[RESET]} ${label_color}%6.2f ms${COLOR[RESET]} ${COLOR[DIM]}│${COLOR[RESET]}\n" \
        "$performance_label" \
        "$total_duration_ms"
fi

# Bottom Border
printf "${COLOR[DIM]}╰───────────────────────────────────────────────────╯${COLOR[RESET]}\n"



# # 2. Header Rendering [OPTION 2]
# # ─────────────────────────────────────────────────────────────
# # We use REVERSE mode (\e[7m) to make the header look like a solid bar.

# # Top Border
# printf "${COLOR[DIM]}╭───────────────────────────────────────────────────╮${COLOR[RESET]}\n"

# # Prepare the "Big" looking text
# # \033[1m = Bold, \033[7m = Reverse (Invert colors)
# local style_big="\033[1;7m"

# if [[ "${ENABLE_MINIMAL_MODE:l}" == "yes" ]]; then
#     printf "${COLOR[DIM]}│${COLOR[RESET]} ${style_big} ZSH [MINI] ${COLOR[RESET]}      ${label_color}%-16s${COLOR[RESET]}    ${label_color}%6.2f ms${COLOR[RESET]}  ${COLOR[DIM]}│${COLOR[RESET]}\n" \
#         "$performance_label" \
#         "$total_duration_ms"
# else
#     # I added extra spaces inside " Z S H " to make it wider
#     printf "${COLOR[DIM]}│${COLOR[RESET]} ${style_big} Z S H  B E N C H ${COLOR[RESET]}  ${label_color}%-16s${COLOR[RESET]}    ${label_color}%6.2f ms${COLOR[RESET]}  ${COLOR[DIM]}│${COLOR[RESET]}\n" \
#         "$performance_label" \
#         "$total_duration_ms"
# fi

# # Bottom Border
# printf "${COLOR[DIM]}╰───────────────────────────────────────────────────╯${COLOR[RESET]}\n"



# 3. Profiling Data Table
# ─────────────────────────────────────────────────────────────
## parses the 'zprof' output to find the most expensive function calls.
## We use 'awk' to generate a visual bar chart inline.

# Table Headers
printf "   ${COLOR[BOLD]}${COLOR[DIM]}%-25s %-10s %-8s %s${COLOR[RESET]}\n" "FUNCTION" "TIME" "CALLS" "LOAD"

# Process Zprof Data
zprof | awk \
    -v color_norm="${COLOR[WHITE]}" \
    -v color_dim="${COLOR[DIM]}" \
    -v color_warn="${COLOR[RED]}" \
    -v color_reset="${COLOR[RESET]}" \
    -v color_func="${COLOR[MAGENTA]}" \
    '{
        # 1. Filter: Only process lines starting with a number
        if ($1 !~ /^[0-9]+\)$/) next

        # 2. Extract Name
        fn_name = $NF

        # 3. DEDUPLICATION
        if (seen[fn_name]++) next

        # 4. Limit: Top 10 only
        if (count++ >= 10) exit

        # --- FIX: TRUNCATE LONG NAMES ---
        # If name is longer than 24 chars, cut it and add ".."
        if (length(fn_name) > 24) {
            fn_name = substr(fn_name, 1, 22) ".."
        }

        # 5. Extract Metrics
        calls   = $2
        time_ms = $3 + 0
        percent = $5 + 0

        # 6. Color Logic
        time_color = color_dim
        if (time_ms > 5)  time_color = color_norm
        if (time_ms > 20) time_color = color_warn

        # 7. Bar Chart
        bar_len = int(percent / 5)
        bar_visual = ""
        for(i=0; i<bar_len; i++) bar_visual = bar_visual "■"
        if (bar_visual == "" && percent > 0) bar_visual = "·"

        # 8. Print
        printf "   %s%-25s%s %s%-10s%s %s%-8s%s %s%s%s\n",
            color_func, fn_name, color_reset,
            time_color, time_ms, color_reset,
            color_dim,  calls,   color_reset,
            time_color, bar_visual, color_reset
    }'

# Final spacing
printf "\n${COLOR[DIM]} For detailed analysis:${COLOR[RESET]}${COLOR[BLUE]} _zsh_debug_startup${COLOR[RESET]}\n\n"
