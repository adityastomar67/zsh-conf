#!/usr/bin/env zsh
# ------------------------[  MULTI-NEOVIM SWITCHER  ]------------------------ #

# ........................[  1. Initialization  ]........................ #

if (( ${#NVIM_DISTROS} == 0 )); then return; fi
if ! (( $+commands[git] )); then print -P "%F{yellow}[WARN] MultiVim missing git.%f"; return; fi

# RESOLVE BASE DIRECTORY
# Use the user variable, or fallback to standard XDG config location
local base_dir="${NVIM_CONFIG_BASE:-${XDG_CONFIG_HOME:-$HOME/.config}}"

# ........................[  2. Auto-Install  ]........................ #

for distro in "${(@k)NVIM_DISTROS}"; do
    local config_path="$base_dir/$distro"
    local data="${NVIM_DISTROS[$distro]}"
    local repo_url="${data#*|}"

    if [[ ! -d "$config_path" ]]; then
        print -P "%F{blue}:: Cloning $distro into $config_path...%f" >/dev/null 2>&1
        # Create parent dir if it doesn't exist (e.g. nvim-profiles)
        mkdir -p "$base_dir"
        git clone --quiet --depth 1 "$repo_url" "$config_path" >/dev/null 2>&1
    fi
done

# ........................[  3. Switcher Function  ]........................ #

function nvim() {
    local nvim_version=$(command nvim --version | head -n1 | cut -d ' ' -f2)
    if [[ "$nvim_version" < "v0.9" ]]; then
        command nvim "$@"
        return
    fi

    # Helper to run Neovim with the correct environment
    # If base_dir is custom, we must override XDG_CONFIG_HOME
    function _run_nvim_distro() {
        local app_name="$1"
        shift

        if [[ "$base_dir" == "${XDG_CONFIG_HOME:-$HOME/.config}" ]]; then
            # Standard Path: Just use APPNAME
            NVIM_APPNAME="$app_name" command nvim "$@"
        else
            # Custom Path: Override Config Home + APPNAME
            XDG_CONFIG_HOME="$base_dir" NVIM_APPNAME="$app_name" command nvim "$@"
        fi
    }

    # ---------------------------------------------------------
    # MODE A: CLI Arguments
    # ---------------------------------------------------------
    if [[ $# -gt 0 && ! -f "$1" && ! -d "$1" ]]; then
        local arg="$1"
        for distro in "${(@k)NVIM_DISTROS}"; do
            local data="${NVIM_DISTROS[$distro]}"
            local flag="${data%%|*}"

            if [[ "$arg" == "$flag" ]]; then
                shift
                _run_nvim_distro "$distro" "$@"
                return
            fi
        done
    fi

    # ---------------------------------------------------------
    # MODE B: Interactive Menu
    # ---------------------------------------------------------
    if ! (( $+commands[fzf] )); then
        command nvim "$@"
        return
    fi

    local choices=("default" "${(@k)NVIM_DISTROS}")
    local config
    config=$(printf "%s\n" "${choices[@]}" | fzf \
        --prompt=" Neovim Config ($base_dir)  " \
        --height=~40% --layout=reverse --border --exit-0)

    if [[ -z "$config" ]]; then
        return 0
    elif [[ "$config" == "default" ]]; then
        command nvim "$@"
    else
        _run_nvim_distro "$config" "$@"
    fi
}
