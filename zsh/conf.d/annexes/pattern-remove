# ------------------------------------------------------------------------------
# Function/Module: Interactive Pattern Remover
# Description:
#   A safe, interactive utility to recursively find and delete files matching
#   a specific glob pattern. It features a dynamically sized UI dashboard,
#   strict safety guards against catastrophic deletions, and an interactive
#   review mode using FZF or less.
#
# How it works:
#       1. Validates the input pattern against a strict safety blacklist.
#       2. Uses native Zsh recursive globbing to find all matching files.
#       3. Renders a dynamic dashboard showing match counts and previews.
#       4. Prompts the user to delete, abort, or visually review the matches.
#       5. Executes the deletion using `find` to prevent argument overflow.
#
# Sub-Modules / Components:
#    Safety Engine : Blocks destructive patterns (e.g., /*, .*, /).
#    Search Engine : Uses Zsh native globbing for high-performance scanning.
#    Dashboard UI  : Calculates string lengths to draw a responsive UI box.
#    Interactive   : Handles user input and delegates to FZF/less for review.
#
# Features:
#    Zero Lag     : Native Zsh globbing and array slicing without external forks.
#    Safety First : Hardcoded blacklist for dangerous system-wide wildcards.
#    Review Mode  : Seamless integration with FZF for interactive list inspection.
#
# Dependencies:
#    COLOR        : Global associative array for terminal colors.
#    fzf          : Optional dependency for the interactive review screen.
# ------------------------------------------------------------------------------

## ── File Management Utilities ────────────────────────────────────────────────
## ------------------------------------------------------------------------------

# ── Interactive File Deletion ─────────────────────────────────────────────────
# Function: interactive_pattern_remove
# Logic:
#   - Sets local Zsh options to ensure predictable globbing and pipeline behavior.
#   - Validates the input pattern to prevent accidental mass deletion.
#   - Gathers matching files using recursive Zsh globbing (**/).
#   - Enters a while loop to display the UI and await user instructions.
#   - Calculates optimal padding for the terminal UI box.
#   - Provides a menu to confirm deletion, view the list, or cancel.
# -----------------------------------------------------------------------------


# --- ENVIRONMENT ISOLATION ---
# Ensure standard Zsh behavior for this function regardless of user settings.
emulate -L zsh
setopt localoptions no_xtrace pipefail

local search_pattern="$1"

# --- INPUT VALIDATION ---
# Ensure the user provided a pattern to search for.
if [[ -z "$search_pattern" ]]; then
    print -P "${COLOR[RED]} [ERROR]${COLOR[RESET]} Usage: interactive_pattern_remove ${COLOR[WHITE]}<filename_pattern>${COLOR[RESET]}"
    print -P "        Example: interactive_pattern_remove '*.log'"
    return 1
fi

# --- CRITICAL SAFETY BLACKLIST ---
# !!! CRITICAL: Block root, current, parent, global wildcard, and hidden global wildcard.
# This prevents catastrophic system/directory deletion if a user accidentally types '*'.
if [[ "$search_pattern" == "/" || "$search_pattern" == "/*" || "$search_pattern" == "." || "$search_pattern" == ".." || "$search_pattern" == "*" || "$search_pattern" == ".*" ]]; then
    print -P "${COLOR[RED]} [FATAL]${COLOR[RESET]} Pattern '${COLOR[BOLD]}$search_pattern${COLOR[RESET]}' is too broad/dangerous."
    return 1
fi

# --- NATIVE ZSH SEARCH ENGINE ---
# We use native Zsh globbing instead of external commands (like `find`) for speed.
print -n -P "${COLOR[BLUE]}::${COLOR[RESET]} Scanning for '${COLOR[BOLD]}$search_pattern${COLOR[RESET]}'...";

# ---- NOTE: Glob Modifiers
# ** = Recursive search
# ${~var}   = Forces Zsh to evaluate the wildcard characters in the variable
# (D.N)     = D: Dotfiles included, .: Plain files only, N: Nullglob (no error if empty)
local -a matched_files
matched_files=( **/${~search_pattern}(D.N) )

local total_matches=${#matched_files[@]}

# Clear the "Scanning..." text line using terminal escape sequences (\e[K)
print -n -f "\r\e[K"

# --- EMPTY STATE HANDLING ---
if (( total_matches == 0 )); then
    print -P "${COLOR[GREEN]}✔${COLOR[RESET]} No files found matching '${COLOR[BOLD]}$search_pattern${COLOR[RESET]}'."
    return 0
fi

# --- STATE MACHINE LOOP ---
# Keep the user in the interactive prompt until they make a definitive choice.
while true; do

    # --- DYNAMIC BOX WIDTH CALCULATION ---
    local title_length=32
    local pattern_length=$(( 11 + ${#search_pattern} ))
    local matches_length=$(( 17 + ${#total_matches} ))

    local inner_width=$title_length
    (( pattern_length > inner_width )) && inner_width=$pattern_length
    (( matches_length > inner_width )) && inner_width=$matches_length

    local t_pad_len=$(( inner_width - title_length ))
    local p_pad_len=$(( inner_width - pattern_length ))
    local m_pad_len=$(( inner_width - matches_length ))

    # 1. Initialize empty strings
    local border_line=""
    local title_padding=""
    local pattern_padding=""
    local matches_padding=""

    # 2. Native Zsh Repetition (100% safe for UTF-8 and multibyte characters)
    repeat $inner_width border_line+="─"

    # Only pad if the length is greater than 0
    (( t_pad_len > 0 )) && repeat $t_pad_len title_padding+=" "
    (( p_pad_len > 0 )) && repeat $p_pad_len pattern_padding+=" "
    (( m_pad_len > 0 )) && repeat $m_pad_len matches_padding+=" "

    # --- DASHBOARD UI ---
    # Render the borders and content utilizing the calculated padding.
    print -P "${COLOR[RED]}╭─${border_line}─╮${COLOR[RESET]}"
    print -P "${COLOR[RED]}│${COLOR[RESET]}     󱐖  DELETE PATTERN MATCHES${title_padding}   ${COLOR[RED]} │${COLOR[RESET]}"
    print -P "${COLOR[RED]}├─${border_line}─┤${COLOR[RESET]}"
    print -P "${COLOR[RED]}│${COLOR[RESET]}  Pattern: ${COLOR[DIM]}${search_pattern}${pattern_padding} ${COLOR[RESET]} ${COLOR[RED]}│${COLOR[RESET]}"
    print -P "${COLOR[RED]}│${COLOR[RESET]}  Matches: ${COLOR[DIM]}${total_matches} files${matches_padding} ${COLOR[RESET]} ${COLOR[RED]}│${COLOR[RESET]}"
    print -P "${COLOR[RED]}╰─${border_line}─╯${COLOR[RESET]}"

    # --- TOP 3 PREVIEW ---
    # Native array slicing for previewing the first few matches.
    for (( i=1; i<=3 && i<=total_matches; i++ )); do
        print -P "  ${COLOR[RED]}×${COLOR[RESET]} ${matched_files[i]}"
    done

    # Indicate if there are more files truncated from the preview.
    if (( total_matches > 3 )); then
        print -P "  ${COLOR[DIM]}...and $((total_matches - 3)) more.${COLOR[RESET]}"
    fi

    print -P "\n${COLOR[YELLOW]}⚠  Warning:${COLOR[RESET]} This will ${COLOR[BOLD]}permanently delete${COLOR[RESET]} these files."

    # --- INTERACTIVE INPUT ---
    # Zsh 'read' allows putting the prompt directly in the command.
    # -k 1 reads exactly one character without waiting for Return.
    local user_input_key
    read -k 1 "user_input_key?   [y]es  [N]o  [v]iew full list > "
    print "" # Print trailing newline to move off the prompt line

    # Evaluate the key pressed (converted to lowercase via (L))
    case "${(L)user_input_key}" in

        # --- EXECUTE DELETION ---
        y)
            print -n -P "${COLOR[BLUE]}::${COLOR[RESET]} Deleting..."

            # ---- SAFE: Scalable Deletion
            # We use 'find -delete' here instead of passing the array to 'rm'.
            # If total_matches is massive, passing a huge array to 'rm' might
            # trigger an "Argument list too long" OS-level error.
            command find . -type f -name "$search_pattern" -delete 2>/dev/null

            print -P "\r\e[K   ${COLOR[GREEN]}✔${COLOR[RESET]} Successfully deleted ${COLOR[BOLD]}$total_matches${COLOR[RESET]} files."
            return 0
            ;;

        # --- REVIEW MODE ---
        v)
            # Dump the array into FZF natively if installed, else fallback to 'less'
            if (( $+commands[fzf] )); then
                print -l "${matched_files[@]}" | fzf \
                    --prompt="Review > " \
                    --info=inline \
                    --layout=reverse \
                    --border \
                    --border-label=" $search_pattern " \
                    --header=$'\033[31mPress ESC to return to dashboard\033[0m\n'
            else
                print -l "${matched_files[@]}" | less
            fi

            # Clear the screen after exiting the viewer to redraw the dashboard cleanly
            clear
            continue
            ;;

        # --- ABORT OPERATION ---
        *)
            print -P "   ${COLOR[DIM]}Operation aborted.${COLOR[RESET]}"
            return 0
            ;;
    esac
done
