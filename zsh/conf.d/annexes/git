# ------------------------------------------------------------------------------
# File Purpose
#   A "High-Fidelity" wrapper for the Git CLI.
#   Updated with Zsh ANSI-C quoting to fix "033" output artifacts.
# ------------------------------------------------------------------------------


# 1. Environment Sandbox
emulate -L zsh
setopt localoptions no_xtrace pipefail


# ── module: clone ────────────────────────────────────────────────────────────

function _git_clone() {

    local i_down=' '
    local i_folder=' '

    # 1. Argument Parsing
    local args=("$@")
    local repo_url=""
    local target_dir=""

    for arg in "${args[@]}"; do
        [[ "$arg" =~ ^- ]] && continue
        if [[ -z "$repo_url" ]]; then
            repo_url="$arg"
        else
            target_dir="$arg"
        fi
    done

    if [[ -z "$target_dir" && -n "$repo_url" ]]; then
        target_dir=$(basename "$repo_url" .git)
    fi

    # 2. Render Header
    print -f "\n${COLOR[BLUE]}%s  CLONING REPOSITORY${COLOR[RESET]}\n" "$i_down"
    print -f "${COLOR[DIM]}────────────────────────────────────────────${COLOR[RESET]}\n"
    print -f "Source:  ${COLOR[MAGENTA]}%s${COLOR[RESET]}\n" "$repo_url"
    print -f "Dest:    ${COLOR[DIM]}%s %s${COLOR[RESET]}\n\n" "$i_folder" "$target_dir"

    # 3. Execution & Stream Coloring
    # We pipe 2>&1 to capture output, and use sed to inject the raw escape bytes
    command git clone --progress "$@" 2>&1 | sed \
        -e "s/\(remote:\)/${COLOR[BLUE]}\1${COLOR[RESET]}/g" \
        -e "s/\(Cloning into\)/${COLOR[DIM]}${COLOR[BOLD]}\1${COLOR[RESET]}/g" \
        -e "s/\(100%\)/${COLOR[GREEN]}\1${COLOR[RESET]}/g" \
        -e "s/\(Receiving objects:\)/${COLOR[MAGENTA]}\1${COLOR[RESET]}/g" \
        -e "s/\(Resolving deltas:\)/${COLOR[BLUE]}\1${COLOR[RESET]}/g" \
        -e "s/\(Updating files:\)/${COLOR[MAGENTA]}\1${COLOR[RESET]}/g"

    local exit_code=${pipestatus[1]}

    # 4. Render Footer
    if [[ $exit_code -eq 0 ]]; then
        print -f "\n${COLOR[GREEN]}  SUCCESS${COLOR[RESET]} Repository ready.\n"
        print -f "${COLOR[DIM]}   Run:${COLOR[RESET]} \033[1mcd $PWD/%s${COLOR[RESET]}\n\n" "$target_dir"
    else
        print -f "\n${COLOR[RED]}  FAILED${COLOR[RESET]} Clone encountered errors.\n\n"
    fi

    return $exit_code
}

# ── module: pull ───────────────────────────────────────────────────────────────────────

function _git_pull() {

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        print "${COLOR[RED]} [ERROR]${COLOR[RESET]} Not a git repository."
        exit 1
    fi

    local i_down=' '
    local i_branch=' '
    local i_remote=' '

    local current_branch=$(command git rev-parse --abbrev-ref HEAD 2>/dev/null)
    local remote_name=$(command git remote 2>/dev/null | head -n1)
    [[ -z "$remote_name" ]] && remote_name="origin"

    print -f "\n${COLOR[BLUE]}%s  SYNCING CHANGES${COLOR[RESET]}\n" "$i_down"
    print -f "${COLOR[DIM]}────────────────────────────────────────────${COLOR[RESET]}\n"
    print -f "Local:   ${COLOR[MAGENTA]}%s %s${COLOR[RESET]}\n" "$i_branch" "$current_branch"
    print -f "Remote:  ${COLOR[DIM]}%s %s${COLOR[RESET]}\n\n" "$i_remote" "$remote_name"

    command git pull --progress "$@" 2>&1 | sed \
        -e "s/\(Updating\)/${COLOR[BLUE]}\1${COLOR[RESET]}/g" \
        -e "s/\(Fast-forward\)/${COLOR[MAGENTA]}\1${COLOR[RESET]}/g" \
        -e "s/\(Unpacking objects:\)/${COLOR[DIM]}\1${COLOR[RESET]}/g" \
        -e "s/\(Already up to date.\)/${COLOR[GREEN]}\1${COLOR[RESET]}/g" \
        -e "s/ \+/ ${COLOR[GREEN]}+${COLOR[RESET]}/g" \
        -e "s/ -/ ${COLOR[RED]}-${COLOR[RESET]}/g" \
        -e "s/\(files changed\)/${COLOR[RESET]}\033[1m\1${COLOR[RESET]}/g" \
        -e "s/\(insertions\)/${COLOR[GREEN]}\1${COLOR[RESET]}/g" \
        -e "s/\(deletions\)/${COLOR[RED]}\1${COLOR[RESET]}/g"

    local exit_code=${pipestatus[1]}

    if [[ $exit_code -eq 0 ]]; then
        print -f "\n${COLOR[GREEN]}  UPDATE COMPLETE${COLOR[RESET]}\n\n"
    else
        print -f "\n${COLOR[RED]}  MERGE CONFLICT / ERROR${COLOR[RESET]}\n"
        print -f "${COLOR[DIM]}Check the output above for details.${COLOR[RESET]}\n\n"
    fi

    return $exit_code
}

# ── module: status ───────────────────────────────────────────────────────────

function _git_status() {
    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        print "${COLOR[RED]} [ERROR]${COLOR[RESET]} Not a git repository."
        exit 1
    fi

    git status -sb | awk '
BEGIN {
    # ─── COLORS ───
    C_RESET   = "\033[0m"
    C_BOLD    = "\033[1m"
    C_DIM     = "\033[2m"
    C_RED     = "\033[31m"
    C_GREEN   = "\033[32m"
    C_YELLOW  = "\033[33m"
    C_BLUE    = "\033[34m"
    C_MAGENTA = "\033[35m"
    C_CYAN    = "\033[36m"

    # ─── ICONS ───
    I_BRANCH  = ""
    I_ARROW   = " "
    I_ADDED   = ""
    I_MOD     = ""
    I_DEL     = ""
    I_UNTRACK = ""
    I_RENAME  = ""
    I_FILE    = ""
    I_CLEAN   = ""
    I_WARN    = "" # Conflict Icon

    total_files = 0
}

# ─── HEADERS (Branch Info) ───
/^##/ {
    sub(/^## /, "")
    line = $0

    if (line ~ /Initial commit on/ || line ~ /No commits yet on/) {
        sub(/Initial commit on /, "", line)
        sub(/No commits yet on /, "", line)
    }

    bracket_info = ""
    if (match(line, /\[.*\]/)) {
        bracket_info = substr(line, RSTART, RLENGTH)
        gsub(/ahead/,  C_GREEN  "⇡" C_RESET, bracket_info)
        gsub(/behind/, C_RED    "⇣" C_RESET, bracket_info)
        sub(/\[.*\]/, "", line)
    }

    split(line, branches, "\\.\\.\\.")
    local_br = branches[1]
    remote_br = branches[2]
    gsub(/[[:space:]]+$/, "", local_br)

    printf "\n  " C_MAGENTA C_BOLD "%s %s" C_RESET, I_BRANCH, local_br

    if (remote_br != "") {
        printf " " C_DIM "%s" C_RESET " " C_BLUE "%s" C_RESET, I_ARROW, remote_br
    }
    if (bracket_info != "") {
        printf " %s", bracket_info
    }
    printf "\n  " C_DIM "────────────────────────────────────────────" C_RESET "\n"
    next
}

# ─── FILE STATUS (The Logic Fix) ───
{
    # 1. Capture strict characters (Fixes the whitespace bug)
    x  = substr($0, 1, 1) # Index Status
    y  = substr($0, 2, 1) # Worktree Status
    xy = x y              # Combined Code

    # 2. Get Filename (starts at char 4)
    #    We trim leading/trailing space just in case, though char 4 is usually standard.
    filename = substr($0, 4)

    icon  = I_FILE
    color = C_RESET

    # 3. Status Mapping (Matching your requested features)

    if (xy == "??") {
        # Untracked
        icon = I_UNTRACK; color = C_CYAN
    }
    else if (xy == "UU" || xy == "AA" || xy == "DD") {
        # Unmerged / Conflict (RESTORED FEATURE)
        icon = I_WARN; color = C_RED
    }
    else if (x == "A" || xy == "AM" || xy == "AD") {
        # Added (includes Added-then-Modified)
        icon = I_ADDED; color = C_GREEN
    }
    else if (x == "D" || xy == "RD" || y == "D") {
        # Deleted (Staged or Unstaged)
        icon = I_DEL; color = C_RED
    }
    else if (x == "R" || xy == "RM") {
        # Renamed (RESTORED FEATURE: Shows as Magenta, even if also Modified)
        icon = I_RENAME; color = C_MAGENTA
    }
    else if (xy == "M ") {
        # Modified and Staged (Modified in Index, Clean in Worktree)
        icon = I_MOD; color = C_GREEN
    }
    else {
        # Everything else is Modified (Unstaged " M", or Both "MM")
        icon = I_MOD; color = C_YELLOW
    }

    printf "    %s%s%s  %s\n", color, icon, C_RESET, filename
    total_files++
}

# ─── FOOTER ───
END {
    if (total_files == 0) {
        printf "    " C_GREEN "%s" C_RESET "  " C_DIM "No changes. Working tree clean." C_RESET "\n", I_CLEAN
    } else {
        printf "\n    " C_DIM "(%d files changed)" C_RESET "\n", total_files
    }
    printf "\n"
}
'
}

function _git_log () {

    if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        print "${COLOR[RED]} [ERROR]${COLOR[RESET]} Not a git repository."
        exit 1
    fi

    # Check if FZF is installed using the Zsh $+commands hash.
    if (( $+commands[fzf] )); then
        command git log "$@"
        return 0
    fi

    # ------------------------------------------------------------------------------
    # 3. Clipboard Detection

    # Automatically identifies the correct system command for clipboard operations.
    local copy_cmd
    if        (( $+commands[pbcopy] ));   then copy_cmd="pbcopy"          # macOS
    elif      (( $+commands[wl-copy] ));  then copy_cmd="wl-copy"         # Wayland (Linux)
    elif      (( $+commands[xclip] ));    then copy_cmd="xclip -sel c"    # X11 (Linux)
    elif (( $+commands[clip.exe] )); then copy_cmd="clip.exe"        # WSL (Windows)
    else                                  copy_cmd="cat"             # Fallback
    fi

    # ------------------------------------------------------------------------------
    # 4. Pro Formatting Strategy

    # We define colors using Git's internal %C color syntax.
    local color_hash="%C(bold blue)"
    local color_date="%C(dim)"
    local color_auth="%C(yellow)"
    local color_pipe="%C(dim)"
    local reset="%C(reset)"

    # --- Complex Logic: Strict Table Layout ---
    # We use Git's alignment operators:
    # %<(N,trunc) : Ensures the field is exactly N characters, truncating if longer.
    # This keeps the columns perfectly aligned regardless of author name lengths.
    # Layout: Hash | Date (14ch) | Author (15ch) | Refs + Msg
    local fmt="${color_hash}%h${reset} ${color_pipe}│${reset} ${color_date}%<(14,trunc)%ar${reset} ${color_pipe}│${reset} ${color_auth}%<(15,trunc)%an${reset} ${color_pipe}│${reset}%C(auto)%d${reset} %s"

    # ------------------------------------------------------------------------------
    # 5. Semantic Helpers

    # Regex helper to safely extract the 7+ character hex hash from the FZF line.
    local get_hash="grep -oE '[a-f0-9]{7,}' | head -1"

    # ------------------------------------------------------------------------------
    # 6. Execution & TUI Logic

    # Define the Column Headings
    #    Adjust the spaces inside this string to match your specific "$fmt" layout.
    #    \033[1;4;31m = Bold, Underline, Red
    HEADERS=$'\033[1;4;31mHash\033[0m       \033[1;4;31mAge\033[0m              \033[1;4;31mAuthor\033[0m            \033[1;4;31mMessage\033[0m\n'

    # Define the Shortcuts Help
    KEYS=$'\033[1;33m• Enter:\033[0m  View      \033[1;33m• Ctrl-Y:\033[0m Copy Hash \n\033[1;33m• Ctrl-X:\033[0m Copy Msg  \033[1;33m• Ctrl-O:\033[0m Checkout\n\n'

    # Feed into FZF
    git log --graph --color=always --format="$fmt" "$@" | \
    fzf --ansi --no-sort --reverse --tiebreak=index \
        --height=100% --border --layout=reverse --info=inline \
        --border-label='  Git Log ' \
        --header="${KEYS}${HEADERS}" \
        --preview-window=right:60%:border-left \
        --preview "print {} | $get_hash | xargs -I % git show --color=always %" \
        \
        --bind "enter:execute(print {} | $get_hash | xargs -I % sh -c 'git show --color=always % | less -R')" \
        \
        --bind "ctrl-y:execute-silent(print {} | $get_hash | tr -d '\n' | $copy_cmd)+abort" \
        \
        --bind "ctrl-x:execute-silent(print {} | $get_hash | xargs git log -1 --format=%s | tr -d '\n' | $copy_cmd)+abort" \
        \
        --bind "ctrl-o:execute(print {} | $get_hash | xargs git checkout)"

}


# ── wrapper engine ───────────────────────────────────────────────────────────

# 1. TTY Guard (Don't mess with pipes)
if [[ ! -t 1 ]]; then
    command git "$@"
    return
fi

# 2. Command Interceptor
local cmd="$1"

case "$cmd" in
    status|st|state)
        _git_status
        ;;
    clone|down)
        shift
        _git_clone "$@"
        ;;
    pull|up)
        shift
        _git_pull "$@"
        ;;
    log)
        shift
        _git_log "$@"
        ;;
    *)
        command git "$@"
        ;;
esac

