#!/usr/bin/env zsh

# ─────────────────────────────────────────────────────────────────────────────
# Function/Module: Smart Take (Directory Acquisition & Navigation)
# Description:
#   A heavily upgraded version of the traditional 'take' or 'mkcd' command.
#   It accepts local paths, URLs, or GitHub shorthands, automatically
#   creates or clones the resource, handles conflicts, navigates into the
#   new directory, and presents a visual breadcrumb and content preview.
#
# How it works:
#       1. Validates input and detects if it's a local path, URL, or shorthand.
#       2. Normalizes the target directory name (stripping extensions/URLs).
#       3. Checks for existing directories and prompts for conflict resolution.
#       4. Acquires the resource (mkdir, git clone, or curl archive).
#       5. Navigates into the target and visualizes the location/contents.
#
# Sub-Modules / Components:
#    Input Parser      : Uses regex to classify the input source.
#    Resource Fetcher  : Handles Git clones and HTTP archive downloads.
#    Visualizer        : Renders an ASCII breadcrumb tree and directory preview.
#
# Features:
#    Shorthand Syntax : Expands 'user/repo' into full GitHub URLs automatically.
#    Archive Extraction: Streams remote tarballs directly to disk memory-efficiently.
#    Interactive UI    : Prompts the user before overwriting existing directories.
#
# Dependencies:
#    git    : Required for cloning repositories.
#    curl   : Required for downloading archives.
#    tar/unzip : Required for extracting downloaded archives.
#    COLOR  : Global associative array for terminal colors.
#
# Usage:
#    take <url|directory|shorthand> [target_directory]
# ─────────────────────────────────────────────────────────────────────────────

## ── Directory Acquisition & Navigation ───────────────────────────────────────
## ------------------------------------------------------------------------------

# ── Interactive Directory Management ──────────────────────────────────────────
# Function: smart_take
# Logic:
#   - Sets local Zsh options for safe execution and pipeline error handling.
#   - Validates input and categorizes it using regular expressions.
#   - Sanitizes the target path to ensure clean folder creation.
#   - Prompts for user input if the target directory already exists.
#   - Fetches or creates the directory contents.
#   - Changes the current working directory and displays a structured summary.
# -----------------------------------------------------------------------------


# --- ENVIRONMENT ISOLATION ---
# emulate -L zsh: Restricts configuration changes to this local scope.
# pipefail: Ensures errors in curl | tar pipelines are caught properly.
emulate -L zsh
setopt localoptions no_xtrace pipefail

local source_uri="$1"
local target_directory="$2"

# --- INPUT VALIDATION ---
# Ensure the user provided at least a source argument.
if [[ -z "$source_uri" ]]; then
    print "${COLOR[RED]}[ERROR]${COLOR[RESET]} Usage: smart_take <url|directory|shorthand>"
    return 1
fi

# --- INPUT CLASSIFICATION ---

# Define regular expressions for identifying protocols and shorthands.
local network_protocol_regex='^(https?|git|ssh|ftps?|rsync)://|^[a-zA-Z0-9]+@'
local github_repo_regex='^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$'

local is_remote_url=0
local execution_action=""

# Evaluate the source string against our known patterns.
if [[ "$source_uri" =~ $network_protocol_regex ]]; then
    is_remote_url=1
elif [[ "$source_uri" =~ $github_repo_regex ]] && [[ ! -d "$source_uri" ]]; then

    # ---- NOTE: Shorthand Expansion
    # If the input looks like user/repo and isn't already a local folder,
    # we assume it is a GitHub repository shorthand and expand it.
    print "${COLOR[BLUE]}ℹ${COLOR[RESET]}  Detected GitHub shorthand. Expanding..."

    source_uri="https://github.com/${source_uri}.git"
    is_remote_url=1
fi

# --- TARGET SANITIZATION ---

if (( is_remote_url )); then
    # If no explicit target was provided, we must derive it from the URL.
    if [[ -z "$target_directory" ]]; then

        # ---- SAFE: URL Sanitization
        # Extract a clean folder name from a URL by stripping .git,
        # query parameters, and URL fragments.
        target_directory=$(basename "${source_uri%%.git}")
        target_directory="${target_directory%%\?*}"
        target_directory="${target_directory%%#*}"

        # Strip common archive extensions from the derived folder name.
        if [[ "$target_directory" =~ \.(zip|tar\.|tgz|tbz) ]]; then
            target_directory="${target_directory%.*}"
            target_directory="${target_directory%.tar}"
        fi
    fi
    execution_action="clone"
else
    # If it's a local path, the target is the source itself.
    target_directory="$source_uri"
    execution_action="create"
fi

# --- INTERACTIVE CONFLICT HANDLING ---

# Check if the derived target directory already exists.
if [[ -d "$target_directory" ]]; then
    print "${COLOR[YELLOW]}⚠${COLOR[RESET]}  Target '${COLOR[BOLD]}$target_directory${COLOR[RESET]}' already exists."
    print -n "   [e]nter  [o]verwrite  [c]ancel > "

    local user_confirmation_key
    read -k 1 user_confirmation_key
    print # Print trailing newline

    case "$user_confirmation_key" in
        [eE])
            execution_action="enter"
            ;;
        [oO])
            # !!! CRITICAL: Destructive Operation
            # Removing the old directory to make way for the new acquisition.
            print "   ${COLOR[RED]}🗑${COLOR[RESET]}  Cleaning old directory..."
            rm -rf "$target_directory"
            ;;
        *)
            # Abort execution if user cancels or presses an invalid key.
            return 1
            ;;
    esac
fi

# --- RESOURCE ACQUISITION ROUTINES ---

if [[ "$execution_action" == "enter" ]]; then
    # No structural action needed, proceed directly to navigation phase.
    true
elif [[ "$execution_action" == "create" ]]; then
    # Create standard local directory hierarchy.
    mkdir -p "$target_directory"
elif [[ "$execution_action" == "clone" ]]; then
    print "${COLOR[BLUE]}⬇${COLOR[RESET]}  Acquiring resource..."

    # Logic Branch: Archive Download vs Git Clone
    if [[ "$source_uri" =~ \.(zip|tar\.gz|tgz|tar\.bz2|tbz|tar\.xz)$ ]]; then
        mkdir -p "$target_directory"
        print "   Downloading archive..."

        # ---- SAFE: Memory Efficient Pipeline
        # We stream the download directly into tar for extraction, preventing
        # the need to store large temporary files on the disk if possible.
        if curl -L "$source_uri" | tar xz -C "$target_directory" --strip-components=1 2>/dev/null; then
            true
        else
            # Fallback: We use a temporary file for pure .zip files because
            # standard 'tar' cannot stream-extract them natively.
            local temporary_archive_file=$(mktemp)
            curl -L "$source_uri" -o "$temporary_archive_file"

            if unzip -q "$temporary_archive_file" -d "$target_directory"; then
                rm "$temporary_archive_file"
            else
                print "${COLOR[RED]}[ERROR]${COLOR[RESET]} Extraction failed."
                rm "$temporary_archive_file"
                rmdir "$target_directory"
                return 1
            fi
        fi
    else
        # Default to Shallow Git Clone for speed and minimal disk usage.
        git clone "$source_uri" "$target_directory" --depth 1
    fi
fi

# --- BREADCRUMB UI RENDERING ---

# Attempt to enter the target directory using the Zsh builtin 'cd'.
if builtin cd "$target_directory"; then

    # Replace the literal home directory path with a tilde for prettier display.
    local formatted_current_path="${PWD/#$HOME/~}"

    print "\n${COLOR[GREEN]}✔${COLOR[RESET]}  Landed in: ${COLOR[BOLD]}$target_directory${COLOR[RESET]}"

    # --- Sub-Section: Location Visualization ---
    print "${COLOR[BLUE]}📍 LOCATION:${COLOR[RESET]}"

    local breadcrumb_indent=""

    # Split the path into an array using the slash '/' separator.
    # ${(@s:/:)var} is a Zsh-specific array splitting syntax.
    local directory_segments=("${(@s:/:)formatted_current_path}")

    if [[ "$formatted_current_path" == "/" ]]; then
        print "  /"
    else
        # Handle standard home directory paths gracefully
        if [[ "$formatted_current_path" == ~* ]]; then
            print "  ~"
            # Remove the empty first segment generated by the leading slash
            [[ -z "${directory_segments[1]}" ]] && shift directory_segments
        fi

        # Render the ASCII breadcrumb tree
        local segment
        for segment in "${directory_segments[@]}"; do
            [[ -z "$segment" ]] && continue
            if [[ "$segment" == "~" ]] && continue

            print "  $breadcrumb_indent└── $segment"
            breadcrumb_indent="$breadcrumb_indent    "
        done
        print "  $breadcrumb_indent    ${COLOR[GREEN]}⬆ (You are here)${COLOR[RESET]}"
    fi

    # --- Sub-Section: Content Preview ---

    # Check if the directory is not empty
    if [[ -n "$(ls -A . 2>/dev/null)" ]]; then
        print "\n${COLOR[BLUE]} CONTENTS:${COLOR[RESET]}"

        # Limit the preview to 5 lines to prevent terminal flooding in large repos.
        ls -F --color=auto 2>/dev/null | head -n 5 | sed 's/^/  ├── /'

        local total_item_count=$(ls -A | wc -l)
        if (( total_item_count > 5 )); then
            print "  ... ($((total_item_count - 5)) more)"
        fi
    fi
else
    print "\n${COLOR[RED]}[FATAL]${COLOR[RESET]} Failed to enter directory."
    return 1
fi

