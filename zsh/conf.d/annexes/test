#!/usr/bin/env zsh


mktestfiles() {
    local root="test_rm_zone"

    # 1. Cleanup old test
    rm -rf "$root"
    mkdir -p "$root/subdir"

    echo ":: Creating test files in '$root'..."

    # 2. Create Target Files (The ones you WANT to delete)
    touch "$root/error_1.log"
    touch "$root/error_2.log"
    touch "$root/subdir/server_crash.log"
    touch "$root/subdir/debug with spaces.log"

    # 3. Create Safe Files (The ones you MUST keep)
    touch "$root/keep_me.txt"
    touch "$root/important_data.json"
    touch "$root/subdir/config.yml"

    # 4. Instructions
    echo ":: Done!"
    echo "   Files created:"
    tree "$root" 2>/dev/null || find "$root" # Fallback if tree is missing
    echo
    echo "👉 To test, run:"
    echo "   cd $root"
    echo "   rm_pattern '*.log'"
}


mkloadtest() {
    local root="loadtest_zone"

    # 1. Setup
    echo ":: ⚙️  Setting up load test environment..."
    rm -rf "$root"
    mkdir -p "$root"/{logs,data/backup,cache/v1,cache/v2}

    # 2. Bulk Generation (Using Brace Expansion for speed)
    echo ":: 🚀 Generating 2,500 files..."

    # >> Create 1,500 "Bad" files (*.tmp)
    # Zsh brace expansion {1..N} makes this nearly instant
    touch "$root/logs/error_"{1..500}".tmp"
    touch "$root/cache/v1/junk_"{1..500}".tmp"
    touch "$root/cache/v2/garbage_"{1..500}".tmp"

    # >> Create 1,000 "Good" files (*.safe)
    touch "$root/data/important_"{1..500}".safe"
    touch "$root/data/backup/archive_"{1..500}".safe"

    # 3. Stats
    local total=$(find "$root" -type f | wc -l)
    local targets=$(find "$root" -type f -name "*.tmp" | wc -l)

    echo ":: ✅ Done!"
    echo "   Root Directory: $root"
    echo "   Total Files:    $total"
    echo "   Target Files:   $targets (*.tmp)"
    echo
    echo "👉 TEST COMMAND:"
    echo "   cd $root"
    echo "   rm_pattern '*.tmp'"
}



mktestsort() {
    # 1. SETUP
    emulate -L zsh
    setopt localoptions no_xtrace pipefail

    local file="test_duplicates.txt"
    local c_green="%F{46}"
    local c_blue="%F{39}"
    local c_reset="%f"

    print -P "${c_blue}::${c_reset} Generating heavy test data..."

    # 2. GENERATE DATA
    # We create a base set of 5 lines
    # Then loop it 20,000 times to create 100,000 lines
    # This guarantees 99.99% duplicates to test the logic
    for i in {1..20000}; do
        cat <<EOF >> "$file"
[ERROR] Connection timed out
[INFO] User logged in
[DEBUG] Variable x = null
[WARN] CPU usage high
[INFO] User logged in
EOF
    done

    # 3. SCRAMBLE (Optional, just to ensure it's truly unsorted)
    # If 'shuf' exists, we shuffle. If not, we leave as is (sort still works)
    if (( $+commands[shuf] )); then
        print -P "${c_blue}::${c_reset} Scrambling order..."
        shuf "$file" -o "$file"
    fi

    # 4. STATS
    local count=$(wc -l < "$file" | tr -d ' ')
    local size=$(du -h "$file" | cut -f1)

    print -P "${c_green}✔${c_reset} Created ${c_blue}$file${c_reset}"
    print -P "   Lines: $count"
    print -P "   Size:  $size"
    echo
    print -P "👉 Run: ${c_green}sort_uniq $file${c_reset}"
}


mktestarchive() {
    local test_dir="extract_test_zone"
    mkdir -p "$test_dir/data"

    echo ":: Creating dummy files..."
    touch "$test_dir/data/file1.txt"
    touch "$test_dir/data/file2.log"
    echo "Hello World" > "$test_dir/data/readme.md"

    echo ":: Compressing..."
    tar -czf "test_archive.tar.gz" -C "$test_dir" .

    # Requires zip installed
    if (( $+commands[zip] )); then
        zip -r -q "test_archive.zip" "$test_dir"
    fi

    rm -rf "$test_dir"

    echo ":: Ready."
    echo "👉 Run: extract test_archive.tar.gz"
}
