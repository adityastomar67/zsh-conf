# ------------------------------------------------------------------------------
# File Purpose
#   Provides a professional-grade, interactive Git log browser using FZF.
#
# Problems Solved
#   - Replaces the static 'git log' with a dynamic TUI for faster history auditing.
#   - Solves the difficulty of copying commit hashes or messages in a terminal.
#   - Provides an instant side-by-side diff preview for any highlighted commit.
#   - Standardizes log formatting into a strict, readable table layout.
#
# Features / Responsibilities
#   - Interactive Browsing: Graph-based commit history with real-time diff previews.
#   - Multi-Action Bindings: Copy hashes, copy messages, or checkout commits.
#   - Smart Clipboard: Automatically detects macOS, Wayland, X11, or WSL clipboards.
#   - Table Layout: Force-aligns dates and authors using Git's truncation padding.
#
# Usage Notes
#   - Syntax: glog [standard git log arguments]
#   - Requires: fzf, git, and a compatible clipboard tool.
#
# Project: Zsh-conf
# ------------------------------------------------------------------------------


# ── commit browser engine ───────────────────────────────────────────────────




# ------------------------------------------------------------------------------
# 1. Environment Sandbox

# emulate -L zsh: Restricts option changes to the local function scope.
# pipefail: Ensures the function returns an error if any part of the pipe fails.
emulate -L zsh
setopt localoptions no_xtrace pipefail

# ------------------------------------------------------------------------------
# 2. Dependency Validation

# Check if FZF is installed using the Zsh $+commands hash.
if (( ! $+commands[fzf] )); then
    print -P "%F{red}[ERROR]%f 'fzf' is required." >&2
    return 1
fi

# ------------------------------------------------------------------------------
# 3. Clipboard Detection

# Automatically identifies the correct system command for clipboard operations.
local copy_cmd
if   (( $+commands[pbcopy] ));   then copy_cmd="pbcopy"          # macOS
elif (( $+commands[wl-copy] ));  then copy_cmd="wl-copy"         # Wayland (Linux)
elif (( $+commands[xclip] ));    then copy_cmd="xclip -sel c"    # X11 (Linux)
elif (( $+commands[clip.exe] )); then copy_cmd="clip.exe"        # WSL (Windows)
else                                  copy_cmd="cat"             # Fallback
fi

# ------------------------------------------------------------------------------
# 4. Pro Formatting Strategy

# We define colors using Git's internal %C color syntax.
local color_hash="%C(bold blue)"
local color_date="%C(dim)"
local color_auth="%C(yellow)"
local color_pipe="%C(dim)"
local reset="%C(reset)"

# --- Complex Logic: Strict Table Layout ---
# We use Git's alignment operators:
# %<(N,trunc) : Ensures the field is exactly N characters, truncating if longer.
# This keeps the columns perfectly aligned regardless of author name lengths.
# Layout: Hash | Date (14ch) | Author (15ch) | Refs + Msg
local fmt="${color_hash}%h${reset} ${color_pipe}│${reset} ${color_date}%<(14,trunc)%ar${reset} ${color_pipe}│${reset} ${color_auth}%<(15,trunc)%an${reset} ${color_pipe}│${reset}%C(auto)%d${reset} %s"

# ------------------------------------------------------------------------------
# 5. Semantic Helpers

# Regex helper to safely extract the 7+ character hex hash from the FZF line.
local get_hash="grep -oE '[a-f0-9]{7,}' | head -1"

# ------------------------------------------------------------------------------
# 6. Execution & TUI Logic

# Feed the colored log into FZF
git log --graph --color=always --format="$fmt" "$@" | \
fzf --ansi --no-sort --reverse --tiebreak=index \
    --height=100% --border --layout=reverse --info=inline \
    --header=$'• Enter: View       • Ctrl-Y: Copy Hash \n• Ctrl-X: Copy Msg  • Ctrl-O: Checkout\n\n' \
    --preview-window=right:60%:border-left \
    --preview "echo {} | $get_hash | xargs -I % git show --color=always %" \
    \
    --bind "enter:execute(echo {} | $get_hash | xargs -I % sh -c 'git show --color=always % | less -R')" \
    \
    --bind "ctrl-y:execute-silent(echo {} | $get_hash | tr -d '\n' | $copy_cmd)+abort" \
    \
    --bind "ctrl-x:execute-silent(echo {} | $get_hash | xargs git log -1 --format=%s | tr -d '\n' | $copy_cmd)+abort" \
    \
    --bind "ctrl-o:execute(echo {} | $get_hash | xargs git checkout)"
