# ------------------------------------------------------------------------------
# File Purpose
#   Implements a "Hyper-Jump" directory navigation system.
#
# Problems Solved
#   - Eliminates the tedious typing of `cd ../../../..`.
#   - Replaces manual path traversal with a semantic "dot" notation.
#   - Provides instant feedback on the destination path after jumping.
#
# Features / Responsibilities
#   - Dynamic Alias Generation: Automatically creates aliases from `..` up to 50 levels.
#   - Robust Navigation Engine: Uses a centralized function to build and execute jumps.
#   - Visual Feedback: Displays a clean, colorized confirmation of the jump.
#
# Usage Notes
#   - `..`    : Go up 1 level (Standard)
#   - `...`   : Go up 2 levels
#   - `....`  : Go up 3 levels
#   - `.....` : Go up 4 levels (and so on)
#
# Project: Zsh-conf
# ------------------------------------------------------------------------------


# ── navigation engine ────────────────────────────────────────────────────────



# ------------------------------------------------------------------------------
# Function: _go_up_n_levels
# Description:
#   The core logic for directory jumping. It calculates the relative path
#   string based on the number of dots detected in the alias.
#
# Arguments:
#   $1 : The integer count of levels to ascend.
# ------------------------------------------------------------------------------
function _go_up_n_levels() {
    # ------------------------------------------------------------------------------
    # 1. Environment Sandbox

    # emulate -L zsh: Restricts shell option changes to this function.
    emulate -L zsh

    local count=$1
    local target=""

    # ------------------------------------------------------------------------------
    # 2. Path Construction

    # --- Complex Logic: Relative Path String Building ---
    # We iterate N times to build a string like "../../..".
    # This is safer than using 'cd -N' as it is more portable across shell versions.
    for ((i=0; i<count; i++)); do
        target="../$target"
    done

    # ------------------------------------------------------------------------------
    # 3. Execution & Feedback

    # Attempt to change directory using the builtin 'cd'
    if builtin cd "$target"; then
        # %~ : Zsh-ism for the current directory, with $HOME abbreviated as ~
        print -P "%F{39}🚀 Jumped up %F{255}${count}%F{39} levels to: %F{240}%~%f"
    else
        # ---- SAFE: Handle edge cases where the jump exceeds the file system root
        print -P "%F{red}[ERROR]%f Cannot go up $count levels (Reached Root?)"
    fi
}


# ── alias generator ──────────────────────────────────────────────────────────

# !!! CRITICAL: Dynamic Scoping
# We iterate through a range to define aliases programmatically.
# Note: Zsh aliases can be composed of dots (.), which we leverage here.

# Start with two dots (standard cd ..)
local dots=".."

# ------------------------------------------------------------------------------
# Loop Logic:
#   Iterates from 2 to 50.
#   On each pass, it adds one dot to the string and maps that string
#   to the navigation engine with the current index.
# ------------------------------------------------------------------------------
for i in {2..50}; do
    dots="${dots}."

    # Syntax: alias ...="_go_up_n_levels 2"
    # We use double quotes so that $i is expanded during the alias definition phase.
    alias "$dots"="_go_up_n_levels $i"
done

