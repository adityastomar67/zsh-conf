# ==============================================================================
# [0] GLOBAL STATE & INITIALIZATION
# ==============================================================================

# Evaluate OS exactly once to save CPU cycles and adhere to DRY principles
typeset -g IS_MAC=0
[[ "$OSTYPE" == "darwin"* ]] && IS_MAC=1

# ==============================================================================
# [1] SYSTEM INFO HELPERS
# ==============================================================================

get_os() {
    if (( IS_MAC )); then
        sw_vers -productName
    else
        [[ -f /etc/os-release ]] && source /etc/os-release && print "${PRETTY_NAME:-Linux}" || print "Linux"
    fi
}

get_kernel() {
    command uname -r
}

get_uptime() {
    if (( IS_MAC )); then
        command uptime | awk -F'(up |,| users)' '{print $2}' | xargs
    else
        command uptime -p | sed 's/up //'
    fi
}

get_pkgs() {
    if (( IS_MAC )); then
        if command -v brew >/dev/null; then
            print "$(command brew list --formula | wc -l | tr -d ' ') (brew)"
        elif command -v port >/dev/null; then
             print "$(command port installed | wc -l | tr -d ' ') (port)"
        else
             print "0"
        fi
        return
    fi

    # Linux Package Managers
    local -A managers=(
        "xbps-install" "xbps-query -l"
        "apk"          "apk search"
        "pacman"       "pacman -Q"
        "dnf"          "dnf list installed"
        "rpm"          "rpm -qa"
        "apt"          "apt list --installed"
        "eopkg"        "eopkg li"
        "nix"          "nix-env -qa --installed '*'"
    )

    for cmd query in ${(kv)managers}; do
        if command -v "$cmd" >/dev/null; then
            local count=$(eval "$query" 2>/dev/null | wc -l)
            count=${count// /}
            [[ "$cmd" == "apt" ]] && ((count--))
            print "$count"
            return
        fi
    done
    print "0"
}

get_shell() {
    print "${SHELL##*/}"
}

get_mem() {
    if (( IS_MAC )); then
        print "$(( $(sysctl -n hw.memsize) / 1024 / 1024 )) MB"
    else
        command free --mega | awk 'NR == 2 { print $3" MB" }'
    fi
}

get_disk() {
    if (( IS_MAC )); then
        # Safely target the APFS Data Volume on macOS
        command df -h "$HOME" | awk 'NR==2 {print $3 " / " $2}'
    else
        command df -h / | awk 'NR==2 {print $3 " / " $2}'
    fi
}

get_wm() {
    (( IS_MAC )) && { print "Aqua"; return; }

    local wm="${XDG_CURRENT_DESKTOP#*:}"
    [[ -z "$wm" ]] && wm="$DESKTOP_SESSION"

    if [[ -z "$wm" && -n "$DISPLAY" ]]; then
        local wms=(sway kiwmi wayfire sowm catwm fvwm dwm 2bwm monsterwm tinywm xmonad bspwm i3)
        for w in $wms; do
            if pgrep -x "$w" >/dev/null; then
                wm="$w"
                break
            fi
        done
    fi
    print "${wm:-Unknown}"
}

get_init() {
    if (( IS_MAC )); then
        print "launchd"
    elif pidof -q systemd; then
        print "systemd"
    elif [[ -f '/sbin/openrc' ]]; then
        print "openrc"
    elif [[ -f '/sbin/dinit' ]]; then
        print "dinit"
    else
        print "init"
    fi
}

