#!/usr/bin/env zsh
#  ╦═╗╔═╗╔╗╔╔╦╗╔═╗╔╦╗  ╦ ╦╔═╗╦  ╦
#  ╠╦╝╠═╣║║║ ║║║ ║║║║  ║║║╠═╣║  ║
#  ╩╚═╩ ╩╝╚╝═╩╝╚═╝╩ ╩  ╚╩╝╩ ╩╩═╝╩═╝
#
#  :: Cross-platform Random Wallpaper Manager (Zsh Version)
#  :: Auto-downloads from git if empty.
#  :: Supports: Linux (Feh/Nitrogen) & macOS.
#  :: Created By: GitHub@adityastomar67
#
#  USAGE:
#      1. Make executable: chmod +x RandomWall
#      2. Run:             ./RandomWall           (Sets random wallpaper)
#      3. Update:          ./RandomWall --update  (Re-downloads collection)

# ==============================================================================
# [1] CONFIGURATION
# ==============================================================================

# 'typeset -r' makes these variables Read-Only (constants).
# They cannot be changed later in the script.
typeset -r BG_DIR="${WALL_DIR:-"$HOME/Backdrops"}"
typeset -r REPO_URL="https://github.com/adityastomar67/Wallpapers"

# ==============================================================================
# [2] UTILITIES
# ==============================================================================

# ------------------------------------------------------------------------------
# :: Notify User
#    Detects the OS and uses the appropriate notification tool.
# ------------------------------------------------------------------------------
notify_user() {
    local title="$1"
    local msg="$2"
    local icon="$ZSH_CONFIG_ROOT/bin/reload.svg"

    # Check the Operating System name
    case "$(uname -s)" in
        Darwin*)
            # macOS native notification via AppleScript
            osascript -e "display notification \"$msg\" with title \"$title\""
            ;;
        Linux*)
            # Priority 1: Dunst (Highly customizable notification daemon)
            if command -v dunstify >/dev/null 2>&1; then
                dunstify -u low -i "$icon" "$title" "$msg"
            # Priority 2: Standard Linux notification
            elif command -v notify-send >/dev/null 2>&1; then
                notify-send "$title" "$msg"
            # Fallback: Just print to terminal if no GUI tools exist
            else
                print ":: $title - $msg"
            fi
            ;;
    esac
}

# ------------------------------------------------------------------------------
# :: Setup Wallpapers
#    Clones the repo into a temp folder, flattens structure, moves files, cleanups.
# ------------------------------------------------------------------------------
setup_wallpapers() {
    # Prerequisite check: Ensure Git is installed
    if ! command -v git >/dev/null 2>&1; then
        print -u2 "Error: 'git' is required to download wallpapers."
        return 1
    fi

    notify_user "RandomWall" "Downloading wallpapers..."

    # Ensure target directory exists
    mkdir -p "$BG_DIR"

    # Create a secure temporary directory for downloading
    local temp_dir=$(mktemp -d)

    # Clone Optimization:
    # --quiet: Don't show progress bar
    # --depth 1: Only download the latest commit (saves bandwidth/space)
    # --filter=blob:none: Don't download large files until explicitly needed
    git clone --quiet --depth 1 --filter=blob:none "$REPO_URL" "$temp_dir" || return 1

    # Run file operations inside a Subshell (...)
    # This prevents 'cd' from changing the directory of the main script context.
    (
        cd "$temp_dir" || exit

        # If repo has a 'Static' subfolder, move its contents to root level
        [[ -d "Static" ]] && mv Static/* . 2>/dev/null

        # [Zsh Specific] Enable 'nullglob':
        # If *.png matches nothing, it returns an empty list instead of crashing/erroring.
        setopt nullglob

        # Normalize filenames: Move .pngs to target and rename extension to .jpg
        for file in *.png; do
            mv -- "$file" "$BG_DIR/${file%.*}.jpg"
        done

        # Move standard .jpg/.jpeg files to target
        for file in *.jpg *.jpeg; do
            mv -- "$file" "$BG_DIR/"
        done

        # Reset glob behavior to default
        unsetopt nullglob
    )

    # Remove the temporary download folder
    rm -rf "$temp_dir"
    notify_user "RandomWall" "Wallpaper setup complete."
}

# ------------------------------------------------------------------------------
# :: Apply Wallpaper
#    The actual logic to change the background based on OS.
# ------------------------------------------------------------------------------
apply_wallpaper() {
    local img="$1"
    local os_name="$(uname -s)"

    case "$os_name" in
        Linux*)
            # Try 'feh' first (Fast, simple image viewer/setter)
            if command -v feh >/dev/null 2>&1; then
                feh --no-fehbg --bg-fill "$img"
            # Try 'nitrogen' second (Stores wallpaper state for restarts)
            elif command -v nitrogen >/dev/null 2>&1; then
                nitrogen --set-zoom-fill "$img" --save
            else
                print -u2 "Error: Neither 'feh' nor 'nitrogen' is installed."
                return 1
            fi
            ;;
        Darwin*)
            # macOS: Use System Events via AppleScript to set desktop picture
            osascript -e "tell application \"System Events\" to set picture of every desktop to \"$img\""
            ;;
        *)
            print -u2 "Error: Unsupported OS: $os_name"
            return 1
            ;;
    esac
}

# ==============================================================================
# [3] MAIN EXECUTION
# ==============================================================================

main() {
    # 1. Update Flag Check
    # If user runs './RandomWall --update', delete old folder and re-download.
    if [[ "$1" == "--update" || "$1" == "-u" ]]; then
        print ":: Force updating wallpapers..."
        rm -rf "$BG_DIR"
        setup_wallpapers
        exit 0
    fi

    # 2. Health Check
    # If folder doesn't exist OR folder is empty, run setup.
    # 'ls -A' lists almost all files (checking if empty).
    if [[ ! -d "$BG_DIR" ]] || [[ -z $(ls -A "$BG_DIR" 2>/dev/null) ]]; then
        print ":: No wallpapers found. Initializing setup..."
        setup_wallpapers
    fi

    # 3. Populate Array
    # Enable nullglob so we don't get errors if specific extensions are missing
    setopt nullglob
    local files=("$BG_DIR"/*.jpg "$BG_DIR"/*.jpeg "$BG_DIR"/*.png)
    unsetopt nullglob

    # 4. Safety Check
    if [ ${#files[@]} -eq 0 ]; then
        print -u2 "Error: No images found in $BG_DIR even after setup."
        exit 1
    fi

    # 5. Random Selection [Zsh Math]
    # Bash arrays start at 0. Zsh arrays start at 1.
    # ${#files[@]} gives the total count.
    # RANDOM % Count gives 0 to (Count-1).
    # We add +1 to shift the range to 1 to Count.
    local random_index=$(( (RANDOM % ${#files[@]}) + 1 ))
    local random_img="${files[$random_index]}"

    print ":: Selected: $(basename "$random_img")"

    # 6. Apply
    apply_wallpaper "$random_img"
}

# Pass all command line arguments to the main function
main "$@"
