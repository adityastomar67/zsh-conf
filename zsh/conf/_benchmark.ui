# $ZSH_PATH/zsh/conf/_benchmark.zsh

# Ensure we actually have the data needed
[[ -z "$total_ms" ]] && return

# --- Configuration ---
local c_reset='\033[0m'
local c_time='\033[1;36m'   # Cyan
local c_func='\033[1;35m'   # Purple
local c_warn='\033[1;31m'   # Red
local c_good='\033[1;32m'   # Green
local c_tag='\033[1;33m'    # Yellow
local c_dim='\033[90m'      # Grey
local c_norm='\033[37m'     # White

# --- 1. Header & Rating ---
local rating="Unknown"
local color_rating=$c_norm

if (( total_ms < 40 )); then
    rating="🚀 Blazing Fast"
    color_rating=$c_good
elif (( total_ms < 100 )); then
    rating="⚡ Fast"
    color_rating=$c_time
elif (( total_ms < 200 )); then
    rating="🐢 Acceptable"
    color_rating=$c_time
else
    rating="🐌 Sluggish"
    color_rating=$c_warn
fi

printf "\n${c_dim}╭───────────────────────────────────────────────────╮${c_reset}\n"

if [[ "$MINIMALIST" == "Yes" ]]; then
    printf "${c_dim}│${c_reset}  ZSH ${c_tag}[MINIMAL]${c_reset}    ${color_rating}%-16s${c_reset}    ${color_rating}%6.2f ms${c_reset}  ${c_dim}│${c_reset}\n" "$rating" "$total_ms"
else
    printf "${c_dim}│${c_reset}  ZSH BENCHMARK    ${color_rating}%-16s${c_reset}    ${color_rating}%6.2f ms${c_reset}  ${c_dim}│${c_reset}\n" "$rating" "$total_ms"
fi

printf "${c_dim}╰───────────────────────────────────────────────────╯${c_reset}\n"

# --- 2. The Table ---
printf "   ${c_dim}%-25s %-10s %-8s %s${c_reset}\n" "FUNCTION" "TIME" "CALLS" "LOAD"

# FIX: Removed 'head | tail'. Now passing all output to awk.
zprof | awk \
    -v norm="$c_norm" \
    -v dim="$c_dim" \
    -v warn="$c_warn" \
    -v rst="$c_reset" \
    -v func_col="$c_func" \
    '{
        # Filter: Only process lines starting with a number (e.g. "1)")
        # This ignores headers, separators, and the detailed graph below.
        if ($1 !~ /^[0-9]+\)$/) next

        # Limit to top 10 rows to keep output clean
        if (count++ >= 10) exit

        fn_name = $NF
        t_val = $3 + 0
        pct = $5 + 0  # Percent is column 5 in summary view

        t_color = dim
        if (t_val > 5)  t_color = norm
        if (t_val > 20) t_color = warn

        # Bar chart logic
        bar_len = int(pct / 5)
        bar = ""
        for(i=0;i<bar_len;i++) bar = bar "■"
        if (bar == "") bar = "·"

        printf "   %s%-25s%s %s%-10s%s %s%-8s%s %s%s%s\n",
            func_col, fn_name, rst,
            t_color, $3, rst,
            dim, $2, rst,
            t_color, bar, rst
    }'
echo
