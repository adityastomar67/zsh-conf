# ------------------------[  ZSH MAIN CONFIGURATION  ]------------------------ #
# This file orchestrates the loading of all modules, plugins, and settings.
# It is sourced by the main ~/.zshrc file.


# ........................[  1. Tmux Integration  ]........................ #

# Explicitly handle Tmux launching/attaching logic first
if [[ -r "$ZSH_PATH/zsh/conf/tmux.zsh" ]]; then
    source "$ZSH_PATH/zsh/conf/tmux.zsh"
fi


# ........................[  2. Module Loader  ]........................ #

# Define modules to load (Order matters: env -> opts -> others)
typeset -a core_modules
core_modules=(
    env       # Environment Variables
    opts      # Options & History
    plugs     # Plugin Manager
    keys      # Keybindings
    prompt    # Theme/Prompt
    theme     # Theme Switcher (Optional)
    nvim      # Neovim Switcher (Optional)
    # icons     # Icons & Glyphs (Optional)
)

typeset -a aux_modules
aux_modules=(
    alias     # Aliases
    function  # Custom Functions
)

# Source Core Modules
for mod in $core_modules; do
    [[ -f "$ZSH_PATH/zsh/conf/${mod}.zsh" ]] && source "$ZSH_PATH/zsh/conf/${mod}.zsh"
done

# Source Auxiliary Modules (Suppress output for cleaner startup)
for mod in $aux_modules; do
    [[ -f "$ZSH_PATH/zsh/conf/${mod}.zsh" ]] && source "$ZSH_PATH/zsh/conf/${mod}.zsh" &> /dev/null
done

# Source Offline/Temp Configs
[[ -f "$HOME/.temp_zsh" ]] && source "$HOME/.temp_zsh" &> /dev/null


# ........................[  3. Performance Optimization  ]........................ #

# Compiles .zsh files to .zwc in the background to speed up FUTURE shell starts.
# Zsh automatically prefers the .zwc file if it is newer than the source.
function _zsh_maintain_bytecode() {
    setopt LOCAL_OPTIONS NO_ALIASES  # 🔒 Critical

    local lockfile="/tmp/zsh_compiling.lock"
    # Return if locked (another shell is already compiling)
    [[ -f "$lockfile" ]] && return
    : >| "$lockfile"

    local dir="$ZSH_PATH/zsh/conf"
    local file

    # Compile module files
    for file in "$dir"/*.zsh; do
        if [[ -f "$file" ]]; then
            # Compile if .zwc doesn't exist OR source is newer than .zwc
            if [[ ! -f "${file}.zwc" || "$file" -nt "${file}.zwc" ]]; then
                zcompile "$file"
            fi
        fi
    done

    # Compile plugin files
    for file in "$HOME/.local/share/zap/plugins/**/*.zsh"; do
        if [[ -f "$file" ]]; then
            # Compile if .zwc doesn't exist OR source is newer than .zwc
            if [[ ! -f "${file}.zwc" || "$file" -nt "${file}.zwc" ]]; then
                zcompile "$file"
            fi
        fi
    done

    # Compile main entry points
    local main_rc="$HOME/.zshrc"
    if [[ -f "$main_rc" && ( ! -f "${main_rc}.zwc" || "$main_rc" -nt "${main_rc}.zwc" ) ]]; then
        zcompile "$main_rc"
    fi
    command rm -f "$lockfile"
}

# Run maintenance in background immediately
_zsh_maintain_bytecode &!


# ........................[  4. Finalization  ]........................ #

# Instant terminal clear (Removes initialization artifacts)
echo -en "\x1b[2J\x1b[1;1H"

# Enable Vi-mode for command line editing
[[ "$VI_MODE" == "Yes" ]] && set -o vi


