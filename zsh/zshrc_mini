# ==============================================================================
# INTERACTIVE SHELL GUARD
# ==============================================================================
# Stop here if not running interactively (improves scp/sftp speed)
[[ $- != *i* ]] && return


# ==============================================================================
# HISTORY CONFIGURATION
# ==============================================================================
# Note: Zsh needs a file location to save history across sessions
HISTFILE="$HOME/zhistory"
HISTSIZE=10000
SAVEHIST=10000

# Ignore specific commands (Regex style)
export HISTORY_IGNORE="(ls|cd|pwd|exit|sudo reboot|history|cd -|cd ..)"

setopt INC_APPEND_HISTORY        # Write immediately, don't wait for exit
setopt HIST_IGNORE_ALL_DUPS      # Remove older duplicate entries
setopt HIST_FIND_NO_DUPS         # Don't show duplicates during search
setopt HIST_SAVE_NO_DUPS         # Don't write duplicates to the file

# ==============================================================================
# COMPLETION & PLUGINS
# ==============================================================================
autoload -Uz compinit

# Define cache location
_comp_dump="${ZDOTDIR:-$HOME}/.zcompdump"

# 🔒 ENABLE GLOBBING LOCALLY (Required for the time check)
setopt LOCAL_OPTIONS EXTENDED_GLOB

# Logic:
# 1. Check if the dump file exists AND is less than 20 hours old (.mh-20)
# 2. If yes, use -C to skip checks (0ms)
# 3. If no, regenerate the cache but SKIP the slow permission audit (compaudit)
if [[ -n "$_comp_dump"(#qN.mh-20) ]]; then
  compinit -C
else
  # ⚡ HACK: Mock compaudit to return success immediately.
  # This skips the slow permission checks on every single folder in fpath.
  compaudit() { : }

  compinit

  # Compile the cache to bytecode for faster loading next time
  zcompile "$_comp_dump"

  # Remove the mock
  unfunction compaudit
fi

# Case insensitive tab completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# ==============================================================================
# PROMPT
# ==============================================================================
# Breakdown: User(Blue) / Host(Yellow) [Dir](Grey) Status_Arrow(Green/Red)
PS1=$'%B%F{blue}%n %B%F{red}/ %B%F{yellow}%m%f%b %{\e[3m%}%B%F{grey}[%~]%f%b%{\e[23m%}%(?.%B%F{green} .%F{red} )%f%b '

# ==============================================================================
# ALIASES
# ==============================================================================

# -- Core Replacements --
alias cat="bat --theme=TwoDark"
alias ls='eza --icons=always --color=always -a'
alias ll='eza --icons=always --color=always -la'
alias v='nvim'
alias py="python3"

# -- Navigation --
alias dv="cd ~/Developer/"

# -- Tmux Utilities --
alias tkill='tmux kill-session -t'

# Improved :q to only run if inside TMUX (kills session or exits shell)
alias ':q'='[ -n "$TMUX" ] && tmux kill-session -t $(tmux display-message -p "#S") || exit'

####--------------------------------------------------
####  Tmux auto-start / auto-attach (Safe Version)
####--------------------------------------------------
# 1. Check if tmux exists
# 2. Check if we are NOT already in tmux
# 3. Check if we are in an interactive terminal (-t 0)
if [[ "$USE_TMUX" == "Yes" ]] && (( $+commands[tmux] )) && [[ -z "$TMUX" && -t 0 ]]; then
    # -A = Attach to existing session if it exists, otherwise create a new one
    # -s = Name of the session
    exec tmux new-session -A -s b001
fi

